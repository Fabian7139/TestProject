FUNCTION_BLOCK "Impulsmerker_FB"
TITLE = Impulsmerker
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : indico
FAMILY : Impulsmerker
VERSION : 1.01
   VAR_INPUT 
      bResetImpulse_I : Bool;
   END_VAR

   VAR_OUTPUT 
      bImpuls_1s_O : Bool;
      bImpuls_1min_O : Bool;
      bImpuls_1h_O : Bool;
   END_VAR

   VAR 
      bImpuls_1s_Old : Bool;   // Hilfsvariable um den alten Zustand zu speichern
      iImpulszaehler_min : Int;
      iImpulszaehler_h : Int;
   END_VAR


BEGIN
	(*****************************************************************************
	* TIA-SOFTWARE
	* W. Wettstein AG, 3073 Gümligen
	* ========================================
	*
	* INDICO ELECTRONIC AG
	* Mattenstrasse 11
	* 3073 Gümligen
	*
	* Utility, Hardware-Konfiguration
	*
	* Beschreibung     :     Impulsmerker 1s/1min/1h
	* Erstellt         :     ns
	* Erstellungsdatum :     04.06.2019
	*
	******************************************************************************)
	
	(*
	*  Aenderungs- und Versionshistory
	*
	*  Version      | Datum         | Autor         | Aenderungen
	*  -------------------------------------------------------------
	*
	*  V1.00         04.06.2019      ns               -Erstellung Funktionsbaustein
	*  V1.01         11.07.2019      jf               -Korrektur Syntax
	*
	*)
	
	IF #bResetImpulse_I THEN
	    //Reset Impulse
	    #bImpuls_1s_Old := FALSE;
	    #iImpulszaehler_min := 0;
	    #iImpulszaehler_h   := 0;    
	END_IF;
	
	
	
	//Impulsgeber 1 Sekunde
	#bImpuls_1s_O   := "Clock_1Hz" AND NOT #bImpuls_1s_Old;
	#bImpuls_1s_Old := "Clock_1Hz";
	
	
	
	// Impulsgeber 1 Minute
	#bImpuls_1min_O := FALSE;
	IF (#bImpuls_1s_O)
	THEN
	    #iImpulszaehler_min := #iImpulszaehler_min + 1;
	    
	    IF (#iImpulszaehler_min >= 60) THEN
	        #iImpulszaehler_min := 0;
	        #bImpuls_1min_O     := TRUE;
	    END_IF;
	END_IF;
	
	
	
	// Impulsgeber 1 Stunde
	#bImpuls_1h_O := FALSE;
	IF (#bImpuls_1s_O)
	THEN
	    #iImpulszaehler_h := #iImpulszaehler_h + 1;
	    
	    IF (#iImpulszaehler_h >= 3600) THEN
	        #iImpulszaehler_h := 0;
	        #bImpuls_1h_O     := TRUE;
	    END_IF;
	END_IF;
	
	
END_FUNCTION_BLOCK

