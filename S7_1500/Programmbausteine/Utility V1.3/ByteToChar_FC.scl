FUNCTION "ByteToChar_FC" : Void
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : indico
VERSION : 0.1
   VAR_INPUT 
      bytIn : Byte;
   END_VAR

   VAR_OUTPUT 
      charH : Char;
      charL : Char;
   END_VAR

   VAR_TEMP 
      bytTemp : Byte;
      iTemp : Int;
   END_VAR


BEGIN
	#bytTemp := #bytIn;
	#bytTemp := SHR(IN := #bytTemp, N := 4);
	#iTemp := BYTE_TO_INT(#bytTemp) + 48;
	#charH := INT_TO_CHAR(#iTemp);
	#bytTemp := #bytIn;
	#bytTemp := #bytTemp & 16#0F;
	#iTemp := BYTE_TO_INT(#bytTemp) + 48;
	#charL := INT_TO_CHAR(#iTemp);
	
	
	
END_FUNCTION

