FUNCTION_BLOCK "OB_Überwachung_FB"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR 
      al_Diagnosealarm { ExternalVisible := 'False'; S7_SetPoint := 'False'} : "WMS_MeldungsWrapperMitQuit_FB";
      al_ZiehenStecken { ExternalVisible := 'False'; S7_SetPoint := 'False'} : "WMS_MeldungsWrapperMitQuit_FB";
      al_Baugruppenträgerausfall { ExternalVisible := 'False'; S7_SetPoint := 'False'} : "WMS_MeldungsWrapperMitQuit_FB";
      al_Programmierfehler { ExternalVisible := 'False'; S7_SetPoint := 'False'} : "WMS_MeldungsWrapperMitQuit_FB";
      al_Peripheriezugriffsfehler { ExternalVisible := 'False'; S7_SetPoint := 'False'} : "WMS_MeldungsWrapperMitQuit_FB";
      al_Zeitfehler { ExternalVisible := 'False'; S7_SetPoint := 'False'} : "WMS_MeldungsWrapperMitQuit_FB";
   END_VAR


BEGIN
	(*****************************************************************************
	* TIA-SOFTWARE
	* W. Wettstein AG, 3073 Gümligen
	* ========================================
	*
	* INDICO ELECTRONIC AG
	* Mattenstrasse 11
	* 3073 Gümligen
	*
	* Bildbausteine
	*
	* Beschreibung     :     OB_Überwachung_FC
	* Erstellt         :     jf
	* Erstellungsdatum :     29.11.2018
	*
	******************************************************************************)
	
	(*
	*  Aenderungs- und Versionshistory
	*
	*  Version      | Datum         | Autor         | Aenderungen
	*  -------------------------------------------------------------
	*
	*  V1.00        29.11.2018      jf              - erster Release   
	*  V1.10        24.06.2022      sf              - Alarme zu WMS angepasst
	*  V1.20        02.02.2024      mh              - Alarm für Zeitfehler (OB80) ergänzt
	*      
	*)
	
	(* Abhängigkeiten
	*  - "Alarm_Setzen_FC"
	*  - Zyklus_DB
	*)
	
	IF "Zyklus_DB".bAlarmReset OR "Zyklus_DB".bInit THEN
	    "Zyklus_DB".OB80.diCountOld := "Zyklus_DB".OB80.diCount;
	    "Zyklus_DB".OB82.diCountOld := "Zyklus_DB".OB82.diCount;
	    "Zyklus_DB".OB83.diCountOld := "Zyklus_DB".OB83.diCount;
	    "Zyklus_DB".OB86.diCountOld := "Zyklus_DB".OB86.diCount;
	    "Zyklus_DB".OB121.diCountOld := "Zyklus_DB".OB121.diCount;
	    "Zyklus_DB".OB122.diCountOld := "Zyklus_DB".OB122.diCount;
	END_IF;
	
	#al_Diagnosealarm(bTrigger := "Zyklus_DB".OB82.diCount <> "Zyklus_DB".OB82.diCountOld,
	                  wEreignis_ID := 10,
	                  wBezeichnung_ID := 0);
	
	#al_ZiehenStecken(bTrigger := "Zyklus_DB".OB83.diCount <> "Zyklus_DB".OB83.diCountOld,
	                  wEreignis_ID := 11,
	                  wBezeichnung_ID := 0);
	
	#al_Baugruppenträgerausfall(bTrigger := "Zyklus_DB".OB86.diCount <> "Zyklus_DB".OB86.diCountOld,
	                            wEreignis_ID := 12,
	                            wBezeichnung_ID := 0);
	
	#al_Programmierfehler(bTrigger := "Zyklus_DB".OB121.diCount <> "Zyklus_DB".OB121.diCountOld,
	                      wEreignis_ID := 13,
	                      wBezeichnung_ID := 0);
	
	#al_Peripheriezugriffsfehler(bTrigger := "Zyklus_DB".OB122.diCount <> "Zyklus_DB".OB122.diCountOld,
	                             wEreignis_ID := 14,
	                             wBezeichnung_ID := 0);
	
	#al_Zeitfehler(bTrigger := "Zyklus_DB".OB80.diCount <> "Zyklus_DB".OB80.diCountOld,
	               wEreignis_ID := 15,
	               wBezeichnung_ID := 0);
	
END_FUNCTION_BLOCK

