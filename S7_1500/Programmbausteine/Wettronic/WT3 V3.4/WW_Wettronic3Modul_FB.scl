FUNCTION_BLOCK "WW_Wettronic3Modul_FB"
TITLE = WW_Wettronic3Modul_FB
{ S7_Optimized_Access := 'FALSE' }
AUTHOR : indico
VERSION : 3.4
   VAR_INPUT 
      bFreigabe_I : Bool;
      WMS_BezeichnungsNr_I : Int;   // WMS Bezeichnungsnummer der Meldetextlisten Wo, PID Tag, EMSR Produkt
      bExternFehler_I : Bool;
      bStartbefehlVerbund_I : Bool;
      bStartbefehlVerdichter_I : Bool;
      bExternSperre_I : Bool;
      bGrundlastVerdichter_I : Bool;
      rRemoteIstwert_I : Real;
      rRemoteSollwert_I : Real;
      b_DO_Alarm_I : Bool;   // TRUE = OK
      b_DO_Warnung_I : Bool;   // TRUE = OK
      b_DO_VerdichterBereit_I : Bool;
      b_DO_VerbundBereit_I : Bool;
      bModbusTCPDisconnect_I : Bool;   // FALSE = Verbindung Aktiv / Bei Multiverdichter darf pro WT3 nur eine Kommunikation aktiv sein z.B. GQ01: aktiv(FALSE) und GQ02,GQ03: passiv(TRUE) / Modbus Startadressen müssen immer eingetragen werden
      iModbusTCPConnectionID_I : CONN_OUC := 5;   // Muss einmalig sein. Beispiel GQ01 = 5, GQ02 = 6
      iModbusTCPLocalPort_I : UInt := 502;   // Muss einmalig sein. Beispiel GQ01 = 502, GQ02 = 503
      hwInterfaceId : HW_INTERFACE := "Local~PROFINET-Schnittstelle_1";   // HW_INTERFACE ID der CPU Netzwerkschnittstelle
      "iPlattform_Status_Start-Adr_I" : UInt;   // 1 = Modbus Startadresse von WT3 (VD1) / 0 = Ausgeschaltet
      "iVerdichter_Status_Start-Adr_I" : UInt;   // 946 = Modbus Startadresse von WT3 (VD1) / 0 = Ausgeschaltet
      "iVerbund_Status_Start-Adr_I" : UInt;   // 316 = Modbus Startadresse von WT3 (VD1) / 0 = Ausgeschaltet
      "iVerdampfer_Status_Start-Adr_I" : UInt;   // 2600 = Modbus Startadresse von WT3 (VD1) / 0 = Ausgeschaltet
      "iKondensator_Status_Start-Adr_I" : UInt;   // 1970 = Modbus Startadresse von WT3 (VD1) / 0 = Ausgeschaltet
      "iPlattform_Eingangssignal_Start-Adr_I" : UInt;   // 3000 = Modbus Startadresse von WT3 (VD1) / 0 = Ausgeschaltet
      "iPlattform_Ausgangssignal_Start-Adr_I" : UInt;   // 3120 = Modbus Startadresse von WT3 (VD1) / 0 = Ausgeschaltet
   END_VAR

   VAR_OUTPUT 
      bVerdichterBereit_O : Bool;
      bVerbundBereit_O : Bool;
      b_DI_ExternFehler_O : Bool;
      b_DI_StartbefehlVerbund_O : Bool;
      b_DI_StartbefehlVerdichter_O : Bool;
      b_DI_ExternSperre_O : Bool;
      b_DI_Grundlast_O : Bool;
      r_AI_RemoteIstwert_O : Real;
      r_AI_RemoteSollwert_O : Real;
      b_Antrieb_Reset_FU_O : Bool;
   END_VAR

   VAR_IN_OUT 
      WW_WT3HoldingRegister_DB : "WT3_HoldingRegister_UDT";
   END_VAR

   VAR 
      byReserve : Array[0..44] of Byte;
      HMI : Struct   // Muss auf Byte Adresse 100 Starten
         iZustandWettronicSymbol : Int;
         iZustandVerdichterSymbol : Int;
         byReserve : Array[0..25] of Byte;
         Plattform : Struct
            iZustand : Int;
            byReserve : Array[0..16] of Byte;
         END_STRUCT;
         Verbund : Struct
            iZustand : Int;
            rLeistungsreglerIstwert : Real;
            rLeistungsreglerSollwert : Real;
            rVerbundleistungIst : Real;
            rVerbundleistungSoll : Real;
            iAnzahlLaufendeVerdichter : Int;
            byReserve : Array[0..28] of Byte;
         END_STRUCT;
         Verdichter : Struct
            iZustand : Int;
            rP_DruckseiteTemp : Real;
            rP_DruckseiteDruck : Real;
            rT_Druckseite : Real;
            rP_SaugseiteTemp : Real;
            rP_SaugseiteDruck : Real;
            "rT-Saugseite" : Real;
            rIst_Leistung : Real;
            rSoll_Leistung : Real;
            rP_Oel_lube : Real;
            rP_Oeldifferenz : Real;
            rMotorstrom : Real;
            rMotorauslastung : Real;
            rLeistung : Real;
            byReserve : Array[0..45] of Byte;
         END_STRUCT;
         Antrieb : Struct   // Nur noch für Reset FU
            iReserve : Int;   // War ehemals Status
            bResetFu : Bool;
            bResetFuAktiv : Bool;
            byReserve : Array[0..44] of Byte;
         END_STRUCT;
         Modbus : Struct
            bModbusEinAus { S7_SetPoint := 'True'} : Bool := TRUE;   // 0 = Aus / 1 = Ein
            wFehlerstatus : Word;
            wAuftragsstatus : Word;
            dtLetzterFehlercode : Date_And_Time;
            dtLetzterAuftragscode : Date_And_Time;
         END_STRUCT;
         Reserve : Array[0..27] of Byte;   // War ehemals Zeitsynchronisation bei WT2
         BezeichnungenSymbol : Struct   // Muss auf Byte Adresse 400 Starten
            sRI_AKS_Bezeichnung_Verdichter : String[30];
            sEl_Bezeichnung_Verdichter : String[10];
            sRI_AKS_Bezeichnung_Niederdruck : String[30];
            sEl_Bezeichnung_Niederdruck : String[10];
            sRI_AKS_Bezeichnung_Hochdruck : String[30];
            sEl_Bezeichnung_Hochdruck : String[10];
            byReserve : Array[0..7] of Byte;
         END_STRUCT;
         HW_Handbedienung : Struct
            bHandEingriffAktiv : Bool;
            byReserve : Array[0..16] of Byte;
            DI : Struct
               Externfehler : "WT_IO_Handbedienung _DIG_UDT";
               StartbefehlVerbund : "WT_IO_Handbedienung _DIG_UDT";
               StartbefehlVerdichter : "WT_IO_Handbedienung _DIG_UDT";
               Externsperre : "WT_IO_Handbedienung _DIG_UDT";
               Grundlast : "WT_IO_Handbedienung _DIG_UDT";
               byReserve : Array[0..59] of Byte;
            END_STRUCT;
            DO : Struct
               Alarm : "WT_IO_Handbedienung _DIG_UDT";
               Warnung : "WT_IO_Handbedienung _DIG_UDT";
               VerdichterBereit : "WT_IO_Handbedienung _DIG_UDT";
               VerbundBereit : "WT_IO_Handbedienung _DIG_UDT";
               byReserve : Array[0..59] of Byte;
            END_STRUCT;
            AI : Struct
               RemoteIstwert : "WT_IO_Handbedienung _ANA_UDT";
               RemoteSollwert : "WT_IO_Handbedienung _ANA_UDT";
            END_STRUCT;
         END_STRUCT;
      END_STRUCT;
      "Timer" : Struct
         TOFF_Reset_FU {InstructionName := 'TOF_TIME'; LibVersion := '1.0'} : TOF_TIME;
         TOFF_VerdichterBereit {InstructionName := 'TOF_TIME'; LibVersion := '1.0'} : TOF_TIME;   // Reserve
         TON_VerdichterBereit {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;   // Reserve
      END_STRUCT;
      ModbusServerInstanz {InstructionName := 'MB_SERVER'; LibVersion := '5.3'} : MB_SERVER;
      ModbusServerData : Struct
         connectParamServer {InstructionName := 'TCON_IP_v4'; LibVersion := '1.0'} : TCON_IP_v4 := (64, 5, 11, false, ([()]), 0, 502);
         serverData : Struct
            disconnect : Bool;
            ndr : Bool;
            dataRead : Bool;
            error : Bool;
            status : Word;
            statusSave : Word;
         END_STRUCT;
      END_STRUCT;
      ModbusHeader { ExternalVisible := 'False'; ExternalWritable := 'False'} : Struct
         Plattform_Status { ExternalVisible := 'False'; ExternalWritable := 'False'} : "WT3_Feldbus_Header" := ((), (), 315, ((), (), (), (), (), ()));
         Verdichter_Status { ExternalVisible := 'False'; ExternalWritable := 'False'} : "WT3_Feldbus_Header" := ((), (), 512, ((), (), (), (), (), ()));
         Verbund_Status { ExternalVisible := 'False'; ExternalWritable := 'False'} : "WT3_Feldbus_Header" := ((), (), 315, ((), (), (), (), (), ()));
         Verdampfer_Status { ExternalVisible := 'False'; ExternalWritable := 'False'} : "WT3_Feldbus_Header" := ((), (), 315, ((), (), (), (), (), ()));
         Kondensator_Status { ExternalVisible := 'False'; ExternalWritable := 'False'} : "WT3_Feldbus_Header" := ((), (), 315, ((), (), (), (), (), ()));
         "Plattform_Ausgangssignal_WT-SPS" { ExternalVisible := 'False'; ExternalWritable := 'False'} : "WT3_Feldbus_Header" := ((), (), 120, ((), (), (), (), (), ()));
      END_STRUCT;
      "Plattform_Eingangssignal_SPS-WT" { ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : "WT3_Plattform_EingangssignalDB_UDT";
      "arPlattform_Eingangssignal_SPS-WT" { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} AT "Plattform_Eingangssignal_SPS-WT" : Array[0..119] of Word;
      "Plattform_Ausgangssignal_WT-SPS" { ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : "WT3_Plattform_AusgangssignalDB_UDT";
      "arPlattform_Ausgangssignal_WT-SPS" { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} AT "Plattform_Ausgangssignal_WT-SPS" : Array[0..119] of Word;
      hw_Handschaltung : "WMS_MeldungsWrapperOhneQuit_FB";
      hw_VdWarnung : "WMS_MeldungsWrapperOhneQuit_FB";
      al_KommAusfallWettronic : "WMS_MeldungsWrapperMitQuit_FB";
      al_KommAusfallModbus : "WMS_MeldungsWrapperMitQuit_FB";
      al_Externfehler : "WMS_MeldungsWrapperMitQuit_FB";
      al_VdAlarm : "WMS_MeldungsWrapperMitQuit_FB";
   END_VAR

   VAR_TEMP 
      Plattform_Status : "WT3_Plattform_Status_UDT";
      arPlattform_Status AT Plattform_Status : Array[0..314] of Word;
      Verdichter_Status : "WT3_Verdichter_Status_UDT";
      arVerdichter_Status AT Verdichter_Status : Array[0..511] of Word;
      Verbund_Status : "WT3_Verbund_Status_UDT";
      arVerbund_Status AT Verbund_Status : Array[0..314] of Word;
      Verdampfer_Status : "WT3_Verdampfer_Status_UDT";
      arVerdampfer_Status AT Verdampfer_Status : Array[0..314] of Word;
      Kondensator_Status : "WT3_Kondensator_Status_UDT";
      arKondensator_Status AT Kondensator_Status : Array[0..314] of Word;
      bHandAktiv : Bool;
      bVDAlarm : Bool;
      bVDWarnung : Bool;
      bVDBereit : Bool;
      bVBBereit : Bool;
      bAlarmHandshake : Bool;
      iTemp : Int;
      wTemp : Word;
      bTON_IN_PREV : Bool;
   END_VAR

   VAR CONSTANT 
      tHandshakeKontrolle : Time := T#30s;
   END_VAR


BEGIN
	(*****************************************************************************
	* TIA-SOFTWARE
	* W. Wettstein AG, 3073 Gümligen
	* ========================================
	*
	* INDICO ELECTRONIC AG
	* Mattenstrasse 11
	* 3073 Gümligen
	*
	* Verdichter Modul
	*
	* Beschreibung     :     Verdichter Modul
	* Erstellt         :     sf
	* Erstellungsdatum :     09.12.2019
	******************************************************************************)
	
	(*
	*  Aenderungs- und Versionshistory
	*
	*  Version      | Datum         | Autor         | Aenderungen
	*  -------------------------------------------------------------
	*
	*  V1.00        09.12.2019       sf             -Neu erstellt
	*  V2.10        08.10.2020       sf             -Modbus Start Adressen von Int zu UInt gewechselt
	*                                               -Befehl Plattform vorbereitet
	*  V2.10        13.10.2020       sf             -Modbus Disconnect auf Schnittstelle geführt (für Multiverdichter)
	*  V2.10        14.10.2020       sf             -FU Reset neu nur während FU Fehler möglich (b_Antrieb_Fehler_I)
	*  V2.20        18.03.2021       sf             -Signalbezeichnungen korrigiert Fehler -> Alarm // Alarm -> Warnung (auch in WT3_xyz_Status_UDTs angepasst)
	*  V2.30        22.09.2021       sf             -Fehler korrigiert: #HMI.Plattform.iZustand wurde mehrfach beschrieben. #HMI.iZustandWettronicSymbol wird neu korrekt abgefüllt
	*                                               Die Verwendung von bHandEingriffAktiv wurde korrigiert
	*  V2.40        15.12.2021       sf             -Standard Modbus Startadressen als Kommentare in den Schnittellen ergänzt
	*  V2.50        25.01.2022       sf             -Verdichter Warnzustand wird neu orange animiert
	*  V2.60        20.05.2022       sf             -Neues Hand-Icon im Verdichtersymbol, HMI.iZustandVerdichterSymbol angepasst
	*               21.07.2022       sf             -iAS durch WMS ersetzt, neue Input Schnittstelle "WMS_BezeichnungsNr_I"
	*  V2.70        07.12.2022       sf             -Der Alarm "Kommunikationsausfall Modbus (Error)" wird neu durch die Handshakeüberwachung aller aktiven Wettronic Komponenten ausgelöst
	*                                               -Alarmtrigger "Antrieb Fehler" korrigiert zu 1 = Fehler
	*  V2.80        08.09.2023       sf             -Abfrage von "b_Antrieb_Fehler_I" für iZustand war falsch, "NOT" entfernt, TRUE = Fehler
	*  V2.90        29.09.2023       sf             -Fehlverhalten von TON Timer abfangen falls sie reinitialisiert werden und stehen bleiben / WMS MeldungsWrapper aktualisiert
	*  V3.00        15.11.2023       sf             -Bei Betrieb im Warnzustand wird das Verdichtersymbol (HMI.iZustandVerdichterSymbol = 8) als Grün/Orange animiert
	*  V3.10        02.12.2024       mh             -Überarbeitung PopUp, Ergänzung von Modbus TCP Informationen und einem Ein-/Ausschalter
	*                                                Ein-/ Ausgänge, Alarme und Status für Antrieb entfernt. FU Reset ist noch vorhanden, wird nun aber immer ausgelöst (b_Antrieb_Fehler_I nicht mehr vorhanden)
	*                                                Status Revision wird neu über ein Kommunikationsflag (#Verdichter_Status.DigIn.bVdMotorRevSchalter) gemacht.
	*  V3.20        02.09.2025       mh             -FS#4768 - WT3 Modul: Warnung nur noch als Hinweis
	*  V3.30        06.01.2026       sf             -FS#4940 - WT3 Modul: Neue Kommunikation / Code-Optimierung und Erweiterung Signalbausteine / Platform heisst neu Plattform
	*  V3.40        30.07.2026       mh             -FS#5074 - WT3 Modul: Bezeichnungen / Die Bezeichnungsvariablen wurden vor die Handbedienung verschoben, Dies soll verhindern, dass 
	*                                                bei Änderungen an der Handbedienung, diese verschoben werden.
	*                                               -FS#5198 - WT3 Modul: Keine Werte bei analogen Eingänge / Die analogen Ausgänge (r_AI_RemoteIstwert_O / r_AI_RemoteSollwert_O) werden nun per Default geschrieben.
	*                                               -FS#5199 - WT3 Modul: Bereit und Restartzeit / Das Optional 2 ist nicht gewünscht, Der Ausgang "bVerdichterBereit_kannStarten_O" entfällt, Der Ausgang «bVerdichterBereit_O» 
	*                                                wird neu unverzögert mit der Variable «bVDBereit» geschrieben.
	*                                               -FS#5300 - WT3 Modul:Schalter Modbus EIN/AUS / Der Eingang «bModbusTCPDisconnect_I» setzt den Softwareschalter nicht mehr zurück.
	*
	*)
	
	(* Abhängikeiten
	* - WT3_HoldingRegister_UDT
	* - WT3_Feldbus_Header
	* - WT3_Kondensator_Status_UDT
	* - WT3_Plattform_AusgangssignalDB_UDT
	* - WT3_Plattform_EingangssignalDB_UDT
	* - WT3_Plattform_Status_UDT
	* - WT3_Verbund_Status_UDT
	* - WT3_Verdampfer_Status_UDT
	* - WT3_Verdichter_Status_UDT
	*)
	
	(* Alarme / Hinweise
	* Alarme ---------------------------------------
	* 10 = Kommunikationsausfall Modbus
	* 11 = Kommunikationsausfall Verdichter
	* 12 = Externfehler aktiv 
	* 14 = Verdichter Alarm aktiv
	* 15 = Verdichter Warnung aktiv
	*
	* Hinweise -------------------------------------
	*  0 = Handschaltung aktiv
	*)
	
	
	REGION INIT
	    
	    // Temp Vars
	    #bHandAktiv := FALSE;
	    #bAlarmHandshake := FALSE;
	    
	END_REGION
	
	REGION Modbus Kommunikation
	    
	    // Modbus Parameter übergeben
	    #ModbusServerData.serverData.disconnect := #bModbusTCPDisconnect_I OR (NOT #HMI.Modbus.bModbusEinAus);
	    #ModbusServerData.connectParamServer.InterfaceId := #hwInterfaceId;
	    #ModbusServerData.connectParamServer.ID := #iModbusTCPConnectionID_I;
	    #ModbusServerData.connectParamServer.LocalPort := #iModbusTCPLocalPort_I;
	    
	    // Modbus Server Instanz
	    #ModbusServerInstanz(DISCONNECT := #ModbusServerData.serverData.disconnect,
	                         NDR => #ModbusServerData.serverData.ndr,
	                         DR => #ModbusServerData.serverData.dataRead,
	                         ERROR => #ModbusServerData.serverData.error,
	                         STATUS => #ModbusServerData.serverData.status,
	                         MB_HOLD_REG := #WW_WT3HoldingRegister_DB,
	                         CONNECT := #ModbusServerData.connectParamServer);
	    
	    // Je nach CPU unterstützt MB_SERVER nur die Übergabe von Arrays. Aus diesem Grund wird in den Statischen Variablen das HoldingRegisterArray überlagert
	    
	    // Error Status lesen
	    IF #ModbusServerData.serverData.error THEN
	        #ModbusServerData.serverData.statusSave := #ModbusServerData.serverData.status;
	        #HMI.Modbus.wFehlerstatus := #ModbusServerData.serverData.statusSave;
	        #iTemp := RD_LOC_T(OUT => #HMI.Modbus.dtLetzterFehlercode);
	    END_IF;
	    
	    // Auftrags Status lesen, wenn neue Daten geschrieben oder gelesen wurden
	    IF #ModbusServerData.serverData.ndr OR #ModbusServerData.serverData.dataRead THEN
	        #HMI.Modbus.wAuftragsstatus := #ModbusServerData.serverData.status;
	        #iTemp := RD_LOC_T(OUT => #HMI.Modbus.dtLetzterAuftragscode);
	    END_IF;
	    
	    REGION Modbus Daten lesen & Handshake kontrollieren
	        
	        REGION Plattform Status
	            // Modbus Startadresse abfüllen
	            #ModbusHeader.Plattform_Status.uiMbStartadresse := #"iPlattform_Status_Start-Adr_I";
	
	            // Daten lesen / Handshake Überwachung
	            "WW_WT3ModbusDatenLesen_FC"(feldbusHeader_IO := #ModbusHeader.Plattform_Status,
	                                        vModbusData_IO := #arPlattform_Status,
	                                        bAlarmHandshake_IO := #bAlarmHandshake);
	        END_REGION
	        
	        REGION Verdichter Status
	            // Modbus Startadresse abfüllen
	            #ModbusHeader.Verdichter_Status.uiMbStartadresse := #"iVerdichter_Status_Start-Adr_I";
	            
	            // Daten lesen / Handshake Überwachung
	            "WW_WT3ModbusDatenLesen_FC"(feldbusHeader_IO := #ModbusHeader.Verdichter_Status,
	                                        vModbusData_IO := #arVerdichter_Status,
	                                        bAlarmHandshake_IO := #bAlarmHandshake);
	        END_REGION
	        
	        REGION Verbund Status
	            // Modbus Startadresse abfüllen
	            #ModbusHeader.Verbund_Status.uiMbStartadresse := #"iVerbund_Status_Start-Adr_I";
	            
	            // Daten lesen / Handshake Überwachung
	            "WW_WT3ModbusDatenLesen_FC"(feldbusHeader_IO := #ModbusHeader.Verbund_Status,
	                                        vModbusData_IO := #arVerbund_Status,
	                                        bAlarmHandshake_IO := #bAlarmHandshake);
	        END_REGION
	        
	        REGION Verdampfer Status
	            // Modbus Startadresse abfüllen
	            #ModbusHeader.Verdampfer_Status.uiMbStartadresse := #"iVerdampfer_Status_Start-Adr_I";
	            
	            // Daten lesen / Handshake Überwachung
	            "WW_WT3ModbusDatenLesen_FC"(feldbusHeader_IO := #ModbusHeader.Verdampfer_Status,
	                                        vModbusData_IO := #arVerdampfer_Status,
	                                        bAlarmHandshake_IO := #bAlarmHandshake);
	        END_REGION
	        
	        REGION Kondensator Status
	            // Modbus Startadresse abfüllen
	            #ModbusHeader.Kondensator_Status.uiMbStartadresse := #"iKondensator_Status_Start-Adr_I";
	            
	            // Daten lesen / Handshake Überwachung
	            "WW_WT3ModbusDatenLesen_FC"(feldbusHeader_IO := #ModbusHeader.Kondensator_Status,
	                                        vModbusData_IO := #arKondensator_Status,
	                                        bAlarmHandshake_IO := #bAlarmHandshake);
	        END_REGION
	        
	        REGION Plattform Ausgangssignal
	            // Statement section REGION
	            // Modbus Startadresse abfüllen
	            #ModbusHeader."Plattform_Ausgangssignal_WT-SPS".uiMbStartadresse := #"iPlattform_Ausgangssignal_Start-Adr_I";
	            
	            // Daten lesen / Handshake Überwachung
	            "WW_WT3ModbusDatenLesen_FC"(feldbusHeader_IO := #ModbusHeader."Plattform_Ausgangssignal_WT-SPS",
	                                        vModbusData_IO := #"arPlattform_Ausgangssignal_WT-SPS",
	                                        bAlarmHandshake_IO := #bAlarmHandshake);
	        END_REGION
	        
	    END_REGION
	END_REGION
	
	REGION Plattform
	    
	    REGION Zustand
	        IF #"iPlattform_Status_Start-Adr_I" <> 0 THEN
	            IF #al_KommAusfallModbus.bExist THEN
	                #HMI.Plattform.iZustand := 21; // Kommunikationsausfall
	            ELSIF #Plattform_Status.Zustand.bAlarmzustandAktiv THEN
	                #HMI.Plattform.iZustand := 20; // Alarmzustand
	            ELSIF #Plattform_Status.Zustand.bWarnzustandAktiv THEN
	                #HMI.Plattform.iZustand := 10; // Warnzustand
	            ELSE
	                #HMI.Plattform.iZustand := 0; // I.O
	            END_IF;
	        END_IF;
	    END_REGION
	    
	END_REGION
	
	REGION Verbund
	    
	    REGION Bereit
	        // DO2.10 Verbund Bereit
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := #b_DO_VerbundBereit_I,
	                                     iZustand_O => #HMI.HW_Handbedienung."DO".VerbundBereit.iZustand,
	                                     bAusgang_O => #bVBBereit,
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung."DO".VerbundBereit.iBetriebsart);
	        
	        #bVerbundBereit_O := #bVBBereit;
	    END_REGION
	    
	    
	    // AI4.3 Remote-Istwert Verbund
	    "WT_IO_Handbedienung_ANA_FC"(rEingang_I := #rRemoteIstwert_I,
	                                 rHandWert_I := #HMI.HW_Handbedienung.AI.RemoteIstwert.rHandWert,
	                                 iZustand_O => #HMI.HW_Handbedienung.AI.RemoteIstwert.iZustand,
	                                 rAusgang_O => #HMI.HW_Handbedienung.AI.RemoteIstwert.rAktuellerWert,
	                                 bHandAktiv_IO := #bHandAktiv,
	                                 iBetriebsart_IO := #HMI.HW_Handbedienung.AI.RemoteIstwert.iBetriebsart);
	    
	    // AI4.4 Remote-Sollwert Verbund
	    "WT_IO_Handbedienung_ANA_FC"(rEingang_I := #rRemoteSollwert_I,
	                                 rHandWert_I := #HMI.HW_Handbedienung.AI.RemoteSollwert.rHandWert,
	                                 iZustand_O => #HMI.HW_Handbedienung.AI.RemoteSollwert.iZustand,
	                                 rAusgang_O => #HMI.HW_Handbedienung.AI.RemoteSollwert.rAktuellerWert,
	                                 bHandAktiv_IO := #bHandAktiv,
	                                 iBetriebsart_IO := #HMI.HW_Handbedienung.AI.RemoteSollwert.iBetriebsart);
	    
	    
	    REGION Remote Istwert
	        // Analog -------------------------------------------------------------------------------------------------
	        (*
	        #wTemp := UNSCALE(IN := #HMI.HW_Handbedienung.AI.RemoteIstwert.rAktuellerWert,
	                          HI_LIM := -20,
	                          LO_LIM := +20,
	                          BIPOLAR := FALSE,
	                          OUT => #r_AI_RemoteIstwert_O);
	        *)           
	        // Oder Aufruf WW_AnaOut_FB (Achtung im wGen anlegen!)
	        #r_AI_RemoteIstwert_O := #HMI.HW_Handbedienung.AI.RemoteIstwert.rAktuellerWert; // Default
	        
	    END_REGION
	    
	    REGION Remote Sollwert
	        // Bus Kommunikation ----------------------------------------------------------------------------------
	        (*
	        #"Plattform_Eingangssignal_SPS-WT"."vb1Sollwert(kühlen)" := #HMI.HW_Handbedienung.AI."RemoteSollwert".rAktuellerWert;
	        
	        oder
	        *)
	        #r_AI_RemoteSollwert_O := #HMI.HW_Handbedienung.AI."RemoteSollwert".rAktuellerWert; // Default
	        
	        
	    END_REGION
	    
	    REGION Zustand / Werte
	        IF #"iVerbund_Status_Start-Adr_I" <> 0 THEN
	            // Status
	            IF NOT #bFreigabe_I THEN
	                #HMI.Verbund.iZustand := 21; // Keine Freigabe
	            ELSIF #Verbund_Status.Zustand.bAlarmzustandAktiv THEN
	                #HMI.Verbund.iZustand := 20; // Alarmzustand
	            ELSIF #Verbund_Status.Zustand.bWarnzustandAktiv THEN
	                #HMI.Verbund.iZustand := 10; // Warnzustand
	            ELSE
	                #HMI.Verbund.iZustand := 0; // I.O
	            END_IF;
	            // Werte
	            #HMI.Verbund.rLeistungsreglerIstwert := #Verbund_Status.rLeistRegIst;
	            #HMI.Verbund.rLeistungsreglerSollwert := #Verbund_Status.rLeistRegSoll;
	            #HMI.Verbund.rVerbundleistungIst := #Verbund_Status.rVerbLeistIst;
	            #HMI.Verbund.rVerbundleistungSoll := #Verbund_Status.rVerbLeistSoll;
	            #HMI.Verbund.iAnzahlLaufendeVerdichter := #Verbund_Status.iAnzVd; //#iAnzahlLaufendeVerdichter_I;
	        END_IF;
	    END_REGION
	    
	    REGION Startbefehl Verbund
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := #bStartbefehlVerbund_I AND #bFreigabe_I,
	                                     iZustand_O => #HMI.HW_Handbedienung.DI.StartbefehlVerbund.iZustand,
	                                     bAusgang_O => #b_DI_StartbefehlVerbund_O,
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung.DI.StartbefehlVerbund.iBetriebsart);
	    END_REGION
	END_REGION
	
	REGION Verdichter
	    
	    REGION Zustand / Werte
	        IF #"iVerdichter_Status_Start-Adr_I" <> 0 THEN
	            // Zustand
	            IF NOT #bFreigabe_I THEN
	                #HMI.Verdichter.iZustand := 21; // Keine Freigabe
	            ELSIF #Verdichter_Status.Zustand.bAlarmzustandAktiv THEN
	                #HMI.Verdichter.iZustand := 20; // Alarmzustand
	            ELSIF #Verdichter_Status.Zustand.bAnlaufAuto THEN
	                #HMI.Verdichter.iZustand := 5; // Anlauf Auto
	            ELSIF #Verdichter_Status.Zustand.bAnlaufManuell THEN
	                #HMI.Verdichter.iZustand := 6; // Anlauf Manull
	            ELSIF #Verdichter_Status.Zustand.bBetriebAuto THEN
	                #HMI.Verdichter.iZustand := 1; // Betrieb Auto
	            ELSIF #Verdichter_Status.Zustand.bBetriebManuell THEN
	                #HMI.Verdichter.iZustand := 2; // Betrieb Manuell
	            ELSIF #Verdichter_Status.Zustand.bWarnzustandAktiv THEN
	                #HMI.Verdichter.iZustand := 10; // Warnzustand
	            ELSIF #Verdichter_Status.Zustand.bStopAuto THEN
	                #HMI.Verdichter.iZustand := 7; // Stop Auto
	            ELSIF #Verdichter_Status.Zustand.bStopExtern THEN
	                #HMI.Verdichter.iZustand := 8; // Stop Extern
	            ELSIF #Verdichter_Status.Zustand.bStopManuell THEN
	                #HMI.Verdichter.iZustand := 9; // Stop Manuell
	            ELSE
	                #HMI.Verdichter.iZustand := 0; // AUS
	            END_IF;
	            
	            // Werte
	            #HMI.Verdichter.rP_DruckseiteTemp := #Verdichter_Status.rPDruckGrad;
	            #HMI.Verdichter.rP_DruckseiteDruck := #Verdichter_Status.rPDruckBar;
	            #HMI.Verdichter.rT_Druckseite := #Verdichter_Status.rTDruck;
	            #HMI.Verdichter.rP_SaugseiteTemp := #Verdichter_Status.rPSaugGrad;
	            #HMI.Verdichter.rP_SaugseiteDruck := #Verdichter_Status.rPSaugBar;
	            #HMI.Verdichter."rT-Saugseite" := #Verdichter_Status.rTSaug;
	            #HMI.Verdichter.rIst_Leistung := #Verdichter_Status.rIstleistProz;
	            #HMI.Verdichter.rSoll_Leistung := #Verdichter_Status.rSollleistProz;
	            #HMI.Verdichter.rP_Oel_lube := #Verdichter_Status.rPOelLube;
	            #HMI.Verdichter.rP_Oeldifferenz := #Verdichter_Status.rPOelDiff;
	            #HMI.Verdichter.rMotorstrom := #Verdichter_Status.rMotorstromA;
	            #HMI.Verdichter.rMotorauslastung := #Verdichter_Status.rMotorstromProz;
	            #HMI.Verdichter.rLeistung := #Verdichter_Status.rMotorleistkW;
	        END_IF;
	    END_REGION
	    
	    REGION HW
	        
	        // DI1.2 Externfehler
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := NOT #bExternFehler_I AND #bFreigabe_I,
	                                     iZustand_O => #HMI.HW_Handbedienung.DI.Externfehler.iZustand,
	                                     bAusgang_O => #b_DI_ExternFehler_O,
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung.DI.Externfehler.iBetriebsart);
	        // DI1.8 Startbefehl Verdichter
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := #bStartbefehlVerdichter_I AND #bFreigabe_I,
	                                     iZustand_O => #HMI.HW_Handbedienung.DI.StartbefehlVerdichter.iZustand,
	                                     bAusgang_O => #b_DI_StartbefehlVerdichter_O,
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung.DI.StartbefehlVerdichter.iBetriebsart);
	        // DI1.11 Extern Sperre
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := #bExternSperre_I AND #bFreigabe_I,
	                                     iZustand_O => #HMI.HW_Handbedienung.DI.Externsperre.iZustand,
	                                     bAusgang_O => #b_DI_ExternSperre_O,
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung.DI.Externsperre.iBetriebsart);
	        // DI1.12 Grundlast Verdichter
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := #bGrundlastVerdichter_I AND #bFreigabe_I,
	                                     iZustand_O => #HMI.HW_Handbedienung.DI.Grundlast.iZustand,
	                                     bAusgang_O => #b_DI_Grundlast_O,
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung.DI.Grundlast.iBetriebsart);
	        // DO2.5 Verdichter Bereit
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := #b_DO_VerdichterBereit_I,
	                                     iZustand_O => #HMI.HW_Handbedienung."DO".VerdichterBereit.iZustand,
	                                     bAusgang_O => #bVDBereit,
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung."DO".VerdichterBereit.iBetriebsart);
	        // DO Alarm
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := #b_DO_Alarm_I,
	                                     iZustand_O => #HMI.HW_Handbedienung."DO".Alarm.iZustand,
	                                     bAusgang_O => #bVDAlarm,
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung."DO".Alarm.iBetriebsart);
	        // DO Warnung
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := #b_DO_Warnung_I,
	                                     iZustand_O => #HMI.HW_Handbedienung."DO".Warnung.iZustand,
	                                     bAusgang_O => #bVDWarnung,
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung."DO".Warnung.iBetriebsart);
	        
	        #HMI.HW_Handbedienung.bHandEingriffAktiv := #bHandAktiv;
	        
	    END_REGION
	    
	    REGION Bereit 
	        // Verdichter
	        #bVerdichterBereit_O := #bVDBereit;
	        
	        (* Optional 2 ist nicht gewünscht - Stand 29.07.2026 
	        (*  Optional 2: Der Digitalausgang ist gesetzt, wenn der Verdichter bereit oder
	            automatisch in Betrieb ist. Während der Restartsperre ist er
	            nicht gesetzt, sondern blinkt. Nicht gesetzt ist der Digitalausgang, wenn der Verdichter manuell betrieben wird oder wenn
	            die Extern-Sperre gesetzt ist.*)
	        
	        #Timer.#TOFF_VerdichterBereit(IN := #bVDBereit,
	                                      PT := T#5s,
	                                      Q => #bVerdichterBereit_O); // Evtl. Restartsperre aktiv
	        
	        // Fehlverhalten von TON Timer abfangen falls sie reinitialisiert werden und stehen bleiben
	        #bTON_IN_PREV := #Timer.#TON_VerdichterBereit.IN; // Trigger Zustand aus letztem Zyklus speichern
	        #Timer.#TON_VerdichterBereit(IN := #bVDBereit,
	                                     PT := T#5s,
	                                     Q => #bVerdichterBereit_kannStarten_O); // Keine Restartsperre aktiv
	        IF #bTON_IN_PREV AND #Timer.#TON_VerdichterBereit.IN AND NOT #Timer.#TON_VerdichterBereit.Q AND #Timer.#TON_VerdichterBereit.ET = T#0ms THEN
	            RESET_TIMER(#Timer.#TON_VerdichterBereit);
	        END_IF;
	        *)
	    END_REGION
	    
	END_REGION
	
	REGION Antrieb
	    // Reset
	    #Timer.#TOFF_Reset_FU(IN := #HMI.Antrieb.bResetFu,
	                          PT := T#2s,
	                          Q => #b_Antrieb_Reset_FU_O);
	    #HMI.Antrieb.bResetFuAktiv := #b_Antrieb_Reset_FU_O;
	    #HMI.Antrieb.bResetFu := FALSE;
	    
	END_REGION
	
	REGION Symbol
	    // Animation Verdichter HMI
	    // 0 = Grau / 1 = Grün / 2 = Hell Grün / 4 = Rot / 5 = Gelb / 6 = Orange  (+10 = Hand)
	    IF #"iVerdichter_Status_Start-Adr_I" <> 0 THEN
	        IF NOT #bFreigabe_I THEN
	            #HMI.iZustandVerdichterSymbol := 6; // Keine Freigabe
	        ELSIF #Verdichter_Status.DigIn.bVdMotorRevSchalter THEN
	            #HMI.iZustandVerdichterSymbol := 5; // Revision
	        ELSIF NOT #bVDAlarm OR #Verdichter_Status.Zustand.bAlarmzustandAktiv THEN
	            #HMI.iZustandVerdichterSymbol := 4; // Alarmzustand
	        ELSIF #Verdichter_Status.Zustand.bAnlaufAuto THEN
	            #HMI.iZustandVerdichterSymbol := 2; // Anlauf Auto
	        ELSIF #Verdichter_Status.Zustand.bAnlaufManuell THEN
	            #HMI.iZustandVerdichterSymbol := 2; // Anlauf Manuell
	        ELSIF #Verdichter_Status.Zustand.bBetriebAuto OR #Verdichter_Status.Zustand.bBetriebManuell THEN
	            IF NOT #bVDWarnung OR #Verdichter_Status.Zustand.bWarnzustandAktiv THEN
	                #HMI.iZustandVerdichterSymbol := 8; // Betrieb Auto / Manuell mit Warnzustand
	            ELSE
	                #HMI.iZustandVerdichterSymbol := 1; // Betrieb Auto / Manuell
	            END_IF;
	        ELSIF NOT #bVDWarnung OR #Verdichter_Status.Zustand.bWarnzustandAktiv THEN
	            #HMI.iZustandVerdichterSymbol := 7; // Warnzustand
	        ELSIF #Verdichter_Status.Zustand.bStopAuto THEN
	            #HMI.iZustandVerdichterSymbol := 0; // Stop Auto
	        ELSIF #Verdichter_Status.Zustand.bStopExtern THEN
	            #HMI.iZustandVerdichterSymbol := 0; // Stop Extern
	        ELSIF #Verdichter_Status.Zustand.bStopManuell THEN
	            #HMI.iZustandVerdichterSymbol := 0; // Stop Manuell
	        ELSE
	            #HMI.iZustandVerdichterSymbol := 0; // AUS
	        END_IF;
	    ELSE
	        #HMI.iZustandVerdichterSymbol := 0; // AUS
	    END_IF;
	    
	    // Animation Hand Symbol
	    // >= 10 = Hand eingeblendet
	    IF #HMI.HW_Handbedienung.bHandEingriffAktiv OR #Verdichter_Status.Zustand.bStopManuell OR #Verdichter_Status.Zustand.bBetriebManuell OR #Verdichter_Status.Zustand.bAnlaufManuell OR #Verdichter_Status.Zustand.bManuellStoppen THEN
	        #HMI.iZustandVerdichterSymbol += 10;
	    END_IF;
	    
	    // Animation Wettronic HMI
	    // 0 = Weiss / 1 = Grün / 2 = Rot / 3 = Gelb / 4 = Orange
	    IF #"iPlattform_Status_Start-Adr_I" <> 0 THEN
	        IF #al_KommAusfallModbus.bExist OR NOT #bFreigabe_I THEN
	            #HMI.iZustandWettronicSymbol := 0; // Kommunikationsausfall / Keine Freigabe = Weiss
	        ELSIF #Plattform_Status.Zustand.bAlarmzustandAktiv OR #Plattform_Status.Zustand.bWarnzustandAktiv THEN
	            #HMI.iZustandWettronicSymbol := 2; // Alarmzustand / Warnzustand
	        ELSE
	            #HMI.iZustandWettronicSymbol := 1; // I.O
	        END_IF;
	    END_IF;
	    
	END_REGION
	
	REGION Alarme / Hinweise
	    
	    REGION Alarme
	        
	        #al_KommAusfallModbus(bTrigger:=#bAlarmHandshake AND #bFreigabe_I,
	                              wBezeichnung_ID:=INT_TO_WORD(#WMS_BezeichnungsNr_I));
	        
	        // Ueberwachung Handshake Vd1 (Kommunikationsausfall)
	        #al_KommAusfallWettronic(bTrigger := #ModbusHeader.Verdichter_Status.bKommAlarm AND #bFreigabe_I,
	                                 wBezeichnung_ID := INT_TO_WORD(#WMS_BezeichnungsNr_I));
	        
	        // Externfehler aktiv
	        #al_Externfehler(bTrigger:=NOT #b_DI_ExternFehler_O AND #bFreigabe_I,
	                         wBezeichnung_ID:=INT_TO_WORD(#WMS_BezeichnungsNr_I));
	        
	        // Verdichter Alarm aktiv
	        #al_VdAlarm(bTrigger:=NOT #bVDAlarm AND #bFreigabe_I,
	                    wBezeichnung_ID:=INT_TO_WORD(#WMS_BezeichnungsNr_I));
	        
	    END_REGION
	    
	    REGION Hinweise
	        // Hand Eingriff Aktiv
	        #hw_Handschaltung(bTrigger:=#HMI.HW_Handbedienung.bHandEingriffAktiv AND #bFreigabe_I,
	                          wBezeichnung_ID:=INT_TO_WORD(#WMS_BezeichnungsNr_I));
	        
	        // Verdichter Warnung aktiv
	        #hw_VdWarnung(bTrigger := NOT #bVDWarnung AND #bFreigabe_I,
	                      wBezeichnung_ID := INT_TO_WORD(#WMS_BezeichnungsNr_I));
	    END_REGION
	    
	END_REGION
	
	REGION Signalbaustein Plattform
	    REGION Digitale Signale
	        // #"Plattform_Eingangssignal_SPS-WT".gtKonfigsatztBit0 := FALSE;
	        // #"Plattform_Eingangssignal_SPS-WT".gtKonfigsatztBit1 :=
	        // #"Plattform_Eingangssignal_SPS-WT".vb1Startbefehl :=
	        // #"Plattform_Eingangssignal_SPS-WT".vb1SollwertB :=
	        // #"Plattform_Eingangssignal_SPS-WT".vb2Startbefehl :=
	        // #"Plattform_Eingangssignal_SPS-WT".vb2SollwertB :=
	        // #"Plattform_Eingangssignal_SPS-WT".kd1Niveauregler1Freigabe :=
	        // #"Plattform_Eingangssignal_SPS-WT".kd1Niveauregler2Freigabe :=
	        // #"Plattform_Eingangssignal_SPS-WT".kd1SollwertB :=
	        // #"Plattform_Eingangssignal_SPS-WT".kd2Niveauregler1Freigabe :=
	        // #"Plattform_Eingangssignal_SPS-WT".kd2Niveauregler2Freigabe :=
	        // #"Plattform_Eingangssignal_SPS-WT".kd2SollwertB :=
	        // #"Plattform_Eingangssignal_SPS-WT".vr1Niveauregler1Freigabe :=
	        // #"Plattform_Eingangssignal_SPS-WT".vr1Niveauregler2Freigabe :=
	        // #"Plattform_Eingangssignal_SPS-WT".vr1SollwertB :=
	        // #"Plattform_Eingangssignal_SPS-WT".vr2Niveauregler1Freigabe :=
	        // #"Plattform_Eingangssignal_SPS-WT".vr2Niveauregler2Freigabe :=
	        // #"Plattform_Eingangssignal_SPS-WT".vr2SollwertB :=
	    END_REGION
	    
	    // #"Plattform_Eingangssignal_SPS-WT"."vb1Sollwert(kühlen)" :=
	    // #"Plattform_Eingangssignal_SPS-WT"."vb1SollwertHeizen" :=
	    // #"Plattform_Eingangssignal_SPS-WT"."vb1Leistung/Limit" :=
	    // #"Plattform_Eingangssignal_SPS-WT"."vb1Leistungsbeschränkung" :=
	    // #"Plattform_Eingangssignal_SPS-WT"."vb2Sollwert(kühlen)" :=
	    // #"Plattform_Eingangssignal_SPS-WT"."vb2SollwertHeizen" :=
	    // #"Plattform_Eingangssignal_SPS-WT"."vb2Leistung/Limit" :=
	    // #"Plattform_Eingangssignal_SPS-WT"."vb2Leistungsbeschränkung" :=
	    // #"Plattform_Eingangssignal_SPS-WT"."kd1Sollwert" :=
	    // #"Plattform_Eingangssignal_SPS-WT"."kd2Sollwert" :=
	    // #"Plattform_Eingangssignal_SPS-WT"."vr1Sollwert" :=
	    // #"Plattform_Eingangssignal_SPS-WT"."vr2Sollwert" :=
	    
	END_REGION
	
	REGION Modbus Daten schreiben
	    
	    // Plattform_Eingangssignal
	    IF #"iPlattform_Eingangssignal_Start-Adr_I" <> 0 THEN
	        #"Plattform_Eingangssignal_SPS-WT".Handshake := 1;
	        MOVE_BLK(IN := #"arPlattform_Eingangssignal_SPS-WT"[0],
	                 COUNT := 120, // Komplette Befehlsstruktur kommunizieren
	                 OUT => #WW_WT3HoldingRegister_DB.Index[#"iPlattform_Eingangssignal_Start-Adr_I"]);
	    END_IF;
	
	END_REGION
	
END_FUNCTION_BLOCK

