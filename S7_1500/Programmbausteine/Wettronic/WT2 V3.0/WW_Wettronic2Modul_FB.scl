FUNCTION_BLOCK "WW_Wettronic2Modul_FB"
TITLE = WW_Wettronic2Modul_FB
{ S7_Optimized_Access := 'FALSE' }
AUTHOR : indico
VERSION : 3.0
   VAR_INPUT 
      bFreigabe_I : Bool;
      WMS_BezeichnungsNr_I : Int;
      bExternFehler_I : Bool;
      bStartbefehlVerbund_I : Bool;
      bStartbefehlVerdichter_I : Bool;
      bExternSperre_I : Bool;
      bGrundlastVerdichter_I : Bool;
      rRemoteIstwert_I : Real;
      rRemoteSollwert_I : Real;
      "b_DO2.1_Fehler_I" : Bool;
      "b_DO2.2_Alarm_I" : Bool;
      "b_DO2.5_VerdichterBereit_I" : Bool;
      "b_DO2.10_VerbundBereit_I" : Bool;
      b_Antrieb_Betrieb_I : Bool;
      b_Antrieb_Fehler_I : Bool;   // 1 = Fehler
      b_Antrieb_Revision_I : Bool;
   END_VAR

   VAR_OUTPUT 
      bVerdichterBereit_O : Bool;
      bVerdichterBereit_kannStarten_O : Bool;
      bVerbundBereit_O : Bool;
      "b_DI1.2_ExternFehler_O" : Bool;
      "b_DI1.7_StartbefehlVerbund_O" : Bool;
      "b_DI1.8_StartbefehlVerdichter_O" : Bool;
      "b_DI1.11_ExternSperre_O" : Bool;
      "b_DI1.12_Grundlast_O" : Bool;
      "r_AI4.3_RemoteIstwert_O" : Real;
      "r_AI4.4_RemoteSollwert_O" : Real;
      b_Antrieb_Hauptschütz_O : Bool;
      b_Antrieb_Bereit_O : Bool;
      b_Antrieb_Reset_FU_O : Bool;
   END_VAR

   VAR_IN_OUT 
      Plattform_Status_UDT_IO : "WT2_Pf_Status_UDT";
      Plattform_Befehl_UDT_IO : "WT2_Pf_Befehl_UDT";
      Verbund_Status_UDT_IO : "WT2_Vb_Status_UDT";
      Verbund_Befehl_UDT_IO : "WT2_Vb_Befehl_UDT";
      Verdichter_Status_1_UDT_IO : "WT2_Vd_Status_1_UDT";
      Verdichter_Status_2_UDT_IO : "WT2_Vd_Status_2_UDT";
   END_VAR

   VAR 
      byReserve : Array[0..34] of Byte;
      HMI : Struct
         iZustandWettronicSymbol : Int;
         iZustandVerdichterSymbol : Int;
         byReserve : Array[0..25] of Byte;
         Plattform : Struct
            iZustand : Int;
            byReserve : Array[0..16] of Byte;
         END_STRUCT;
         Verbund : Struct
            iZustand : Int;
            rLeistungsreglerIstwert : Real;
            rLeistungsreglerSollwert : Real;
            rVerbundleistungIst : Real;
            rVerbundleistungSoll : Real;
            iAnzahlLaufendeVerdichter : Int;
            byReserve : Array[0..28] of Byte;
         END_STRUCT;
         Verdichter : Struct
            iZustand : Int;
            rP_DruckseiteTemp : Real;
            rP_DruckseiteDruck : Real;
            rT_Druckseite : Real;
            rP_SaugseiteTemp : Real;
            rP_SaugseiteDruck : Real;
            "rT-Saugseite" : Real;
            rIst_Leistung : Real;
            rSoll_Leistung : Real;
            rP_Oel_lube : Real;
            rP_Oeldifferenz : Real;
            rMotorstrom : Real;
            rMotorauslastung : Real;
            rLeistung : Real;
            byReserve : Array[0..45] of Byte;
         END_STRUCT;
         Antrieb : Struct
            iZustand : Int;
            bResetFu : Bool;
            bResetFuAktiv : Bool;
            byReserve : Array[0..44] of Byte;
         END_STRUCT;
         Zeitsynchronisation : Struct
            iManuelleSynchronisation : Int;
            dtlSPSZeit {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
            dtlWTZeit {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
            byReserve : Array[0..22] of Byte;
         END_STRUCT;
         HW_Handbedienung : Struct
            bHandEingriffAktiv : Bool;
            byReserve : Array[0..16] of Byte;
            DI : Struct
               "1.2_Externfehler" : "WT_IO_Handbedienung _DIG_UDT";
               "1.7_StartbefehlVerbund" : "WT_IO_Handbedienung _DIG_UDT";
               "1.8_StartbefehlVerdichter" : "WT_IO_Handbedienung _DIG_UDT";
               "1.11Externsperre" : "WT_IO_Handbedienung _DIG_UDT";
               "1.12Grundlast" : "WT_IO_Handbedienung _DIG_UDT";
               byReserve : Array[0..59] of Byte;
            END_STRUCT;
            DO : Struct
               "2.1_Fehler" : "WT_IO_Handbedienung _DIG_UDT";
               "2.2_Alarm" : "WT_IO_Handbedienung _DIG_UDT";
               "2.5_VerdichterBereit" : "WT_IO_Handbedienung _DIG_UDT";
               "2.10_VerbundBereit" : "WT_IO_Handbedienung _DIG_UDT";
               byReserve : Array[0..59] of Byte;
            END_STRUCT;
            AI : Struct
               "4.3_RemoteIstwert" : "WT_IO_Handbedienung _ANA_UDT";
               "4.4_RemoteSollwert" : "WT_IO_Handbedienung _ANA_UDT";
            END_STRUCT;
         END_STRUCT;
         BezeichnungenSymbol : Struct
            sRI_AKS_Bezeichnung_Verdichter : String[30];
            sEl_Bezeichnung_Verdichter : String[10];
            sRI_AKS_Bezeichnung_Niederdruck : String[30];
            sEl_Bezeichnung_Niederdruck : String[10];
            sRI_AKS_Bezeichnung_Hochdruck : String[30];
            sEl_Bezeichnung_Hochdruck : String[10];
         END_STRUCT;
      END_STRUCT;
      Zeitsynchronisation : "WW_DTL_TO_WT2_FB";
      "Timer" : Struct
         TOFF_Reset_FU {InstructionName := 'TOF_TIME'; LibVersion := '1.0'} : TOF_TIME;
         TOFF_VerdichterBereit {InstructionName := 'TOF_TIME'; LibVersion := '1.0'} : TOF_TIME;
         TON_VerdichterBereit {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
         TON_Hauptschütz {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
      END_STRUCT;
      hw_Handschaltung { S7_SetPoint := 'False'} : "WMS_MeldungsWrapperOhneQuit_FB";
      hw_Revision : "WMS_MeldungsWrapperOhneQuit_FB";
      hw_ZeitsyncFehlgeschlagen : "WMS_MeldungsWrapperOhneQuit_FB";
      al_KommAusfallWettronic : "WMS_MeldungsWrapperMitQuit_FB";
      al_Externfehler : "WMS_MeldungsWrapperMitQuit_FB";
      al_VdFehler : "WMS_MeldungsWrapperMitQuit_FB";
      al_VdAlarm : "WMS_MeldungsWrapperMitQuit_FB";
      al_AntriebFehler : "WMS_MeldungsWrapperMitQuit_FB";
   END_VAR

   VAR_TEMP 
      bHandAktiv : Bool;
      bVDFehler : Bool;
      bVDAlarm : Bool;
      bVDBereit : Bool;
      bVBBereit : Bool;
      wTemp : Word;
      bTemp : Bool;
   END_VAR


BEGIN
	(*****************************************************************************
	* TIA-SOFTWARE
	* W. Wettstein AG, 3073 Gümligen
	* ========================================
	*
	* INDICO ELECTRONIC AG
	* Mattenstrasse 11
	* 3073 Gümligen
	*
	* Verdichter Modul
	*
	* Beschreibung     :     Verdichter Modul
	* Erstellt         :     jf
	* Erstellungsdatum :     05.12.2018
	******************************************************************************)
	
	(*
	*  Aenderungs- und Versionshistory
	*
	*  Version      | Datum         | Autor         | Aenderungen
	*  -------------------------------------------------------------
	*
	*  V1.00        05.12.2018       jf             -Neu erstellt
	*  V1.10        07.12.2018       jf             -Überwachung eingefügt / Zeit lesen von WT2
	*  V1.20        18.02.2019       jf             -Startbefehl Namensgebung korrigiert (D1.8/D1.7) / Antrieb Zustand NOT bei Fehler und Revision eingefügt.  
	*  V1.30        25.04.2019       jf             -Startbefehl Antrieb entfernt / RemoteIstwert & RemoteSollwert auf Real geändert und verknüpft / Reset FU ohne Verknüpfung / iZustand erweitert (Visu angepasst)
	*  V1.40        02.07.2019       jf             -Neues WWAG Symbol verknüpft
	*  V1.50        14.10.2020       sf             -FU Reset neu nur während FU Fehler möglich (b_Antrieb_Fehler_I)
	*  V1.60        22.09.2021       sf             -Fehler korrigiert: #HMI.Plattform.iZustand wurde mehrfach beschrieben. #HMI.iZustandWettronicSymbol wird neu korrekt abgefüllt
	*                                                Die Verwendung von bHandEingriffAktiv wurde korrigiert
	*  V1.70        25.01.2022       sf             -Verdichter Alarmzustand wird neu orange animiert
	*  V1.80        20.05.2022       sf             -Neues Hand-Icon im Verdichtersymbol, HMI.iZustandVerdichterSymbol angepasst
	*  V1.90        21.07.2022       sf             -iAS durch WMS ersetzt, neue Input Schnittstelle "WMS_BezeichnungsNr_I"
	*  V2.00        29.09.2023       sf             -Fehlverhalten von TON Timer abfangen falls sie reinitialisiert werden und stehen bleiben / WMS MeldungsWrapper aktualisiert
	*  V3.00        15.11.2023       sf             -Bei Betrieb im Alarmzustand wird das Verdichtersymbol (HMI.iZustandVerdichterSymbol = 8) als Grün/Orange animiert
	*)
	
	
	(* Abhängikeiten
	* - WW_DTL_TO_WT2_FB
	* - Zyklus_DB
	* - "WT2_Pf_Status_UDT"
	* - "WT2_Pf_Befehl_UDT"
	* - "WT2_Vb_Status_UDT"
	* - "WT2_Vb_Befehl_UDT"
	* - "WT2_Vd_Status_1_UDT"
	* - "WT2_Vd_Status_2_UDT"
	*)
	
	(* Alarme / Hinweise
	* Alarme ---------------------------------------
	*  0 = Kommunikationsausfall zu Platform
	* +1 = Externfehler aktiv 
	* +2 = Verdichter Fehler aktiv
	* +3 = Verdichter Alarm aktiv
	* +4 = Antrieb Fehler
	* +5 = Kein Rückmeldung Betrieb
	*
	* Hinweise -------------------------------------
	*  0 = Handschaltung aktiv
	* +1 = Antrieb Revision
	*)
	
	REGION INIT
	    
	    // Temp Vars
	    #bHandAktiv := FALSE;
	    
	END_REGION
	
	REGION Plattform
	    
	    REGION Zeitsynchronisation              
	        IF "CheckReferenz_FC"(#Plattform_Befehl_UDT_IO) AND
	           "CheckReferenz_FC"(#Plattform_Status_UDT_IO) THEN
	           
	                #HMI.Zeitsynchronisation.dtlSPSZeit := "Zyklus_DB".dtlSystemzeit;
	                
	                #Zeitsynchronisation(dtlAktuelleZeit_I := "Zyklus_DB".dtlSystemzeit,
	                                     bAktuelleZeitGueltig_I := #bFreigabe_I,
	                                     dtlAktuelleZeitWT2_O => #HMI.Zeitsynchronisation.dtlWTZeit,
	                                     Platform_Befehl_UDT_IO := #Plattform_Befehl_UDT_IO,
	                                     iManuelSync_IO := #HMI.Zeitsynchronisation.iManuelleSynchronisation,
	                                     Platform_Status_UDT_IO := #Plattform_Status_UDT_IO);
	        ELSE
	            #HMI.Zeitsynchronisation.iManuelleSynchronisation := 21; // Keine Synchronisation Projektiert
	            
	        END_IF;
	    END_REGION
	    
	    REGION Zustand
	        IF "CheckReferenz_FC"(#Plattform_Status_UDT_IO) THEN
	            IF #al_KommAusfallWettronic.bExist THEN
	                #HMI.Plattform.iZustand := 21; // Kommunikationsausfall
	            ELSIF #Plattform_Status_UDT_IO.Zustand.bFehlerzustandAktiv THEN
	                #HMI.Plattform.iZustand := 20; // Fehlerzustand
	            ELSIF #Plattform_Status_UDT_IO.Zustand.bAlarmzustandAktiv THEN
	                #HMI.Plattform.iZustand := 10; // Alarmzustand
	            ELSE
	                #HMI.Plattform.iZustand := 0; // I.O
	            END_IF;
	        END_IF;
	    END_REGION
	    
	END_REGION
	
	REGION Verbund
	    
	    REGION Bereit
	        // DO2.10 Verbund Bereit
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := #"b_DO2.10_VerbundBereit_I",
	                                     iZustand_O => #HMI.HW_Handbedienung."DO"."2.10_VerbundBereit".iZustand,
	                                     bAusgang_O => #bVBBereit,
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung."DO"."2.10_VerbundBereit".iBetriebsart);
	        
	        #bVerbundBereit_O := #bVBBereit;
	    END_REGION
	    
	    
	    // AI4.3 Remote-Istwert Verbund
	    "WT_IO_Handbedienung_ANA_FC"(rEingang_I := #rRemoteIstwert_I,
	                                 rHandWert_I := #HMI.HW_Handbedienung.AI."4.3_RemoteIstwert".rHandWert,
	                                 iZustand_O => #HMI.HW_Handbedienung.AI."4.3_RemoteIstwert".iZustand,
	                                 rAusgang_O => #HMI.HW_Handbedienung.AI."4.3_RemoteIstwert".rAktuellerWert,
	                                 bHandAktiv_IO := #bHandAktiv,
	                                 iBetriebsart_IO := #HMI.HW_Handbedienung.AI."4.3_RemoteIstwert".iBetriebsart);
	    
	    // AI4.4 Remote-Sollwert Verbund
	    "WT_IO_Handbedienung_ANA_FC"(rEingang_I := #rRemoteSollwert_I,
	                                 rHandWert_I := #HMI.HW_Handbedienung.AI."4.4_RemoteSollwert".rHandWert,
	                                 iZustand_O => #HMI.HW_Handbedienung.AI."4.4_RemoteSollwert".iZustand,
	                                 rAusgang_O => #HMI.HW_Handbedienung.AI."4.4_RemoteSollwert".rAktuellerWert,
	                                 bHandAktiv_IO := #bHandAktiv,
	                                 iBetriebsart_IO := #HMI.HW_Handbedienung.AI."4.4_RemoteSollwert".iBetriebsart);
	    
	    
	    REGION Remote Istwert
	        // Analog -------------------------------------------------------------------------------------------------
	        
	        (*
	        #wTemp := UNSCALE(IN := #HMI.HW_Handbedienung.AI."4.3_RemoteIstwert".rAktuellerWert,
	                          HI_LIM := -20,
	                          LO_LIM := +20,
	                          BIPOLAR := FALSE,
	                          OUT => #"r_AI4.3_RemoteIstwert_O");
	        // Oder Aufruf WW_AnaOut_FB (Achtung im wGen anlegen!) 
	        
	        #"r_AI4.3_RemoteIstwert_O" := #HMI.HW_Handbedienung.AI."4.3_RemoteIstwert".rAktuellerWert;
	        *)
	    END_REGION
	    
	    REGION Remote Sollwert
	        // Bus Kommunikation ----------------------------------------------------------------------------------
	        (*
	        IF (#Verbund_Befehl_UDT_IO.iHandshake = 0) THEN
	            // neuen Sollwert schreiben
	            #Verbund_Befehl_UDT_IO.rFernSollwert := #HMI.HW_Handbedienung.AI."4.4_RemoteSollwert".rAktuellerWert;
	            #Verbund_Befehl_UDT_IO.iHandshake := 3;
	        ELSE
	            // warten
	            ;
	        END_IF;
	        
	        oder
	        
	        #"r_AI4.4_RemoteSollwert_O" := #HMI.HW_Handbedienung.AI."4.4_RemoteSollwert".rAktuellerWert;
	        
	        *)
	    END_REGION
	    
	    REGION Zustand / Werte
	        IF "CheckReferenz_FC"(#Verbund_Status_UDT_IO) THEN
	            // Status
	            IF NOT #bFreigabe_I THEN
	                #HMI.Verbund.iZustand := 21; // Keine Freigabe
	            ELSIF #Verbund_Status_UDT_IO.Zustand.bFehlerzustandAktiv THEN
	                #HMI.Verbund.iZustand := 20; // Fehlerzustand
	            ELSIF #Verbund_Status_UDT_IO.Zustand.bAlarmzustandAktiv THEN
	                #HMI.Verbund.iZustand := 10; // Alarmzustand
	            ELSE
	                #HMI.Verbund.iZustand := 0; // I.O
	            END_IF;
	            // Werte
	            #HMI.Verbund.rLeistungsreglerIstwert := #Verbund_Status_UDT_IO.rLeistRegIst;
	            #HMI.Verbund.rLeistungsreglerSollwert := #Verbund_Status_UDT_IO.rLeistRegSoll;
	            #HMI.Verbund.rVerbundleistungIst := #Verbund_Status_UDT_IO.rVerbLeistIst;
	            #HMI.Verbund.rVerbundleistungSoll := #Verbund_Status_UDT_IO.rVerbLeistSoll;
	            #HMI.Verbund.iAnzahlLaufendeVerdichter := #Verbund_Status_UDT_IO.iAnzVd; //#iAnzahlLaufendeVerdichter_I;
	        END_IF;
	    END_REGION
	    
	    REGION Startbefehl Verbund
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := #bStartbefehlVerbund_I AND #bFreigabe_I,
	                                     iZustand_O => #HMI.HW_Handbedienung.DI."1.7_StartbefehlVerbund".iZustand,
	                                     bAusgang_O => #"b_DI1.7_StartbefehlVerbund_O",
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung.DI."1.7_StartbefehlVerbund".iBetriebsart);
	    END_REGION
	END_REGION
	
	REGION Verdichter
	    
	    REGION Zustand / Werte
	        IF "CheckReferenz_FC"(#Verdichter_Status_1_UDT_IO) THEN
	            // Zustand
	            IF NOT #bFreigabe_I THEN
	                #HMI.Verdichter.iZustand := 21; // Keine Freigabe
	            ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bFehlerzustandAktiv THEN
	                #HMI.Verdichter.iZustand := 20; // Fehlerzustand
	            ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bAnlaufAuto THEN
	                #HMI.Verdichter.iZustand := 5; // Anlauf Auto
	            ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bAnlaufManuell THEN
	                #HMI.Verdichter.iZustand := 6; // Anlauf Manull
	            ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bBetriebAuto THEN
	                #HMI.Verdichter.iZustand := 1; // Betrieb Auto
	            ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bBetriebManuell THEN
	                #HMI.Verdichter.iZustand := 2; // Betrieb Manuell
	            ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bAlarmzustandAktiv THEN
	                #HMI.Verdichter.iZustand := 10; // Alarmzustand
	            ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bStopAuto THEN
	                #HMI.Verdichter.iZustand := 7; // Stop Auto
	            ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bStopExtern THEN
	                #HMI.Verdichter.iZustand := 8; // Stop Extern
	            ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bStopManuell THEN
	                #HMI.Verdichter.iZustand := 9; // Stop Manuell
	            ELSE
	                #HMI.Verdichter.iZustand := 0; // AUS
	            END_IF;
	            // Werte
	            #HMI.Verdichter.rP_DruckseiteTemp := #Verdichter_Status_1_UDT_IO.rPDruckGrad;
	            #HMI.Verdichter.rP_DruckseiteDruck := #Verdichter_Status_1_UDT_IO.rPDruckBar;
	            #HMI.Verdichter.rT_Druckseite := #Verdichter_Status_1_UDT_IO.rTDruck;
	            #HMI.Verdichter.rP_SaugseiteTemp := #Verdichter_Status_1_UDT_IO.rPSaugGrad;
	            #HMI.Verdichter.rP_SaugseiteDruck := #Verdichter_Status_1_UDT_IO.rPSaugBar;
	            #HMI.Verdichter."rT-Saugseite" := #Verdichter_Status_1_UDT_IO.rTSaug;
	            #HMI.Verdichter.rIst_Leistung := #Verdichter_Status_1_UDT_IO.rIstleistProz;
	            #HMI.Verdichter.rSoll_Leistung := #Verdichter_Status_1_UDT_IO.rSollleistProz;
	            #HMI.Verdichter.rP_Oel_lube := #Verdichter_Status_1_UDT_IO.rPOelLube;
	            #HMI.Verdichter.rP_Oeldifferenz := #Verdichter_Status_1_UDT_IO.rPOelDiff;
	            #HMI.Verdichter.rMotorstrom := #Verdichter_Status_1_UDT_IO.rMotorstromA;
	            #HMI.Verdichter.rMotorauslastung := #Verdichter_Status_1_UDT_IO.rMotorstromProz;
	            #HMI.Verdichter.rLeistung := #Verdichter_Status_1_UDT_IO.rMotorleistkW;
	        END_IF;
	    END_REGION
	    
	    REGION HW
	        
	        // DI1.2 Externfehler
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := NOT #bExternFehler_I AND #bFreigabe_I,
	                                     iZustand_O => #HMI.HW_Handbedienung.DI."1.2_Externfehler".iZustand,
	                                     bAusgang_O => #"b_DI1.2_ExternFehler_O",
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung.DI."1.2_Externfehler".iBetriebsart);
	        
	        // DI1.8 Startbefehl Verdichter
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := #bStartbefehlVerdichter_I AND #bFreigabe_I,
	                                     iZustand_O => #HMI.HW_Handbedienung.DI."1.8_StartbefehlVerdichter".iZustand,
	                                     bAusgang_O => #"b_DI1.8_StartbefehlVerdichter_O",
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung.DI."1.8_StartbefehlVerdichter".iBetriebsart);
	        // DI1.11 Extern Sperre
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := #bExternSperre_I AND #bFreigabe_I,
	                                     iZustand_O => #HMI.HW_Handbedienung.DI."1.11Externsperre".iZustand,
	                                     bAusgang_O => #"b_DI1.11_ExternSperre_O",
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung.DI."1.11Externsperre".iBetriebsart);
	        // DI1.12 Grundlast Verdichter
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := #bGrundlastVerdichter_I AND #bFreigabe_I,
	                                     iZustand_O => #HMI.HW_Handbedienung.DI."1.12Grundlast".iZustand,
	                                     bAusgang_O => #"b_DI1.12_Grundlast_O",
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung.DI."1.12Grundlast".iBetriebsart);
	        
	        // DO2.5 Verdichter Bereit
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := #"b_DO2.5_VerdichterBereit_I",
	                                     iZustand_O => #HMI.HW_Handbedienung."DO"."2.5_VerdichterBereit".iZustand,
	                                     bAusgang_O => #bVDBereit,
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung."DO"."2.5_VerdichterBereit".iBetriebsart);
	        
	        // DO2.1 Fehler
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := #"b_DO2.1_Fehler_I",
	                                     iZustand_O => #HMI.HW_Handbedienung."DO"."2.1_Fehler".iZustand,
	                                     bAusgang_O => #bVDFehler,
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung."DO"."2.1_Fehler".iBetriebsart);
	        
	        // DO2.2 Alarm
	        "WT_IO_Handbedienung_DIG_FC"(bEingang_I := #"b_DO2.2_Alarm_I",
	                                     iZustand_O => #HMI.HW_Handbedienung."DO"."2.2_Alarm".iZustand,
	                                     bAusgang_O => #bVDAlarm,
	                                     bHandAktiv_IO := #bHandAktiv,
	                                     iBetriebsart_IO := #HMI.HW_Handbedienung."DO"."2.2_Alarm".iBetriebsart);
	        
	        #HMI.HW_Handbedienung.bHandEingriffAktiv := #bHandAktiv;
	        
	    END_REGION
	    
	    REGION Bereit 
	        // Verdichter
	        (*  Optional 2: Der Digitalausgang ist gesetzt, wenn der Verdichter bereit oder
	            automatisch in Betrieb ist. Während der Restartsperre ist er
	            nicht gesetzt, sondern blinkt. Nicht gesetzt ist der Digitalausgang, wenn der Verdichter manuell betrieben wird oder wenn
	            die Extern-Sperre gesetzt ist.*)
	        
	        #Timer.#TOFF_VerdichterBereit(IN := #bVDBereit,
	                                      PT := T#5s,
	                                      Q => #bVerdichterBereit_O); // Evtl. Restartsperre aktiv
	        
	        #Timer.#TON_VerdichterBereit(IN := #bVDBereit,
	                                     PT := T#5s,
	                                     Q => #bVerdichterBereit_kannStarten_O); // Keine Restartsperre aktiv
	        
	        
	    END_REGION
	    
	END_REGION
	
	REGION Antrieb
	    
	    // Hauptschütz
	    #b_Antrieb_Hauptschütz_O := #bFreigabe_I AND #b_Antrieb_Revision_I;
	    
	    // Bereit
	    #Timer.#TON_Hauptschütz(IN := #b_Antrieb_Hauptschütz_O,
	                            PT := T#3s);
	    #b_Antrieb_Bereit_O := #Timer.#TON_Hauptschütz.Q
	    AND NOT #al_AntriebFehler.bExist; // Antrieb Fehler
	    
	    // Reset
	    #Timer.#TOFF_Reset_FU(IN := #b_Antrieb_Fehler_I AND #HMI.Antrieb.bResetFu,
	                          PT := T#2s,
	                          Q => #b_Antrieb_Reset_FU_O);
	    #HMI.Antrieb.bResetFuAktiv := #b_Antrieb_Reset_FU_O;
	    #HMI.Antrieb.bResetFu := FALSE;
	    
	    REGION Zustand
	        
	        IF #b_Antrieb_Reset_FU_O THEN
	            #HMI.Antrieb.iZustand := 22; // Reset FU
	        ELSIF NOT #bFreigabe_I THEN
	            #HMI.Antrieb.iZustand := 21; // Keine Freigabe
	        ELSIF NOT #b_Antrieb_Fehler_I THEN
	            #HMI.Antrieb.iZustand := 24; // Fehler Manuell
	        ELSIF NOT #b_Antrieb_Revision_I THEN
	            #HMI.Antrieb.iZustand := 25; // Revision
	        ELSIF #b_Antrieb_Betrieb_I THEN
	            #HMI.Antrieb.iZustand := 1; // Betrieb
	        ELSE
	            #HMI.Antrieb.iZustand := 0; // Aus
	        END_IF;
	        
	    END_REGION
	    
	END_REGION
	
	REGION Symbol
	    // Animation Verdichter HMI
	    // 0 = Grau / 1 = Grün / 2 = Hell Grün / 4 = Rot / 5 = Gelb / 6 = Orange  (+10 = Hand)
	    IF "CheckReferenz_FC"(#Verdichter_Status_1_UDT_IO) THEN
	        IF NOT #bFreigabe_I THEN
	            #HMI.iZustandVerdichterSymbol := 6; // Keine Freigabe
	        ELSIF NOT #b_Antrieb_Revision_I THEN
	            #HMI.iZustandVerdichterSymbol := 5; // Revision   
	        ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bFehlerzustandAktiv THEN
	            #HMI.iZustandVerdichterSymbol := 4; // Fehlerzustand
	        ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bAnlaufAuto THEN
	            #HMI.iZustandVerdichterSymbol := 2; // Anlauf Auto
	        ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bAnlaufManuell THEN
	            #HMI.iZustandVerdichterSymbol := 2; // Anlauf Manuell
	        ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bBetriebAuto OR #Verdichter_Status_1_UDT_IO.Zustand.bBetriebManuell THEN
	            IF #Verdichter_Status_1_UDT_IO.Zustand.bAlarmzustandAktiv THEN
	                #HMI.iZustandVerdichterSymbol := 8; // Betrieb Auto / Manuell mit Alarmzustand
	            ELSE
	                #HMI.iZustandVerdichterSymbol := 1; // Betrieb Auto / Manuell
	            END_IF;
	        ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bAlarmzustandAktiv THEN
	            #HMI.iZustandVerdichterSymbol := 7; // Alarmzustand
	        ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bStopAuto THEN
	            #HMI.iZustandVerdichterSymbol := 0; // Stop Auto
	        ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bStopExtern THEN
	            #HMI.iZustandVerdichterSymbol := 0; // Stop Extern
	        ELSIF #Verdichter_Status_1_UDT_IO.Zustand.bStopManuell THEN
	            #HMI.iZustandVerdichterSymbol := 0; // Stop Manuell
	        ELSE
	            #HMI.iZustandVerdichterSymbol := 0; // AUS
	        END_IF;
	    END_IF;
	    
	    // Animation Hand Symbol
	    // >= 10 = Hand eingeblendet
	    IF #HMI.HW_Handbedienung.bHandEingriffAktiv OR #Verdichter_Status_1_UDT_IO.Zustand.bStopManuell OR #Verdichter_Status_1_UDT_IO.Zustand.bBetriebManuell OR #Verdichter_Status_1_UDT_IO.Zustand.bAnlaufManuell OR #Verdichter_Status_1_UDT_IO.Zustand.bManuellStoppen THEN
	        #HMI.iZustandVerdichterSymbol += 10;
	    END_IF;
	    
	    // Animation Wettronic HMI
	    // 0 = Weiss / 1 = Grün / 2 = Rot / 3 = Gelb / 4 = Orange
	    IF "CheckReferenz_FC"(#Plattform_Status_UDT_IO) THEN
	        IF #al_KommAusfallWettronic.bExist OR NOT #bFreigabe_I THEN
	            #HMI.iZustandWettronicSymbol := 0; // Kommunikationsausfall / Keine Freigabe = Weiss
	        ELSIF #Plattform_Status_UDT_IO.Zustand.bFehlerzustandAktiv OR #Plattform_Status_UDT_IO.Zustand.bAlarmzustandAktiv THEN
	            #HMI.iZustandWettronicSymbol := 2; // Fehlerzustand / Alarm
	        ELSE
	            #HMI.iZustandWettronicSymbol := 1; // I.O
	        END_IF;
	    END_IF;
	END_REGION
	
	REGION Alarme / Hinweise
	    
	    REGION Alarme
	        
	        IF "CheckReferenz_FC"(#Verdichter_Status_1_UDT_IO) THEN
	            // Ueberwachung Handshake Vd1 (Kommunikationsausfall)
	            #bTemp := #Verdichter_Status_1_UDT_IO.iHandshake = 0 AND #bFreigabe_I;
	            #Verdichter_Status_1_UDT_IO.iHandshake := 0;
	        ELSE
	            #bTemp := FALSE;
	        END_IF;
	        #al_KommAusfallWettronic(bTrigger := #bTemp,
	                                 wBezeichnung_ID:=INT_TO_WORD(#WMS_BezeichnungsNr_I));
	        
	        // Externfehler aktiv
	        #al_Externfehler(bTrigger:=NOT #"b_DI1.2_ExternFehler_O" AND #bFreigabe_I,
	                         wBezeichnung_ID:=INT_TO_WORD(#WMS_BezeichnungsNr_I));
	        
	        // Verdichter Fehler aktiv
	        #al_VdFehler(bTrigger:=NOT #bVDFehler AND #bFreigabe_I,
	                     wBezeichnung_ID:=INT_TO_WORD(#WMS_BezeichnungsNr_I));
	        
	        // Verdichter Alarm aktiv
	        #al_VdAlarm(bTrigger:=NOT #bVDAlarm AND #bFreigabe_I,
	                    wBezeichnung_ID:=INT_TO_WORD(#WMS_BezeichnungsNr_I));
	        
	        // Antrieb Fehler
	        #al_AntriebFehler(bTrigger:=NOT #b_Antrieb_Fehler_I AND #bFreigabe_I,
	                          wBezeichnung_ID:=INT_TO_WORD(#WMS_BezeichnungsNr_I));
	        
	    END_REGION
	    
	    REGION Hinweise
	        // Hand Eingriff Aktiv
	        // "Hinweis_Setzen_FC"(nr := #iErsterHinweis_I,
	        //                     trigger := #HMI.HW_Handbedienung.bHandEingriffAktiv AND #bFreigabe_I);
	        #hw_Handschaltung(bTrigger:=#HMI.HW_Handbedienung.bHandEingriffAktiv AND #bFreigabe_I,
	                          wBezeichnung_ID:=INT_TO_WORD(#WMS_BezeichnungsNr_I));
	        
	        // Revision
	        // "Hinweis_Setzen_FC"(nr := #iErsterHinweis_I + 1,
	        //                     trigger := NOT #b_Antrieb_Revision_I AND #bFreigabe_I);
	        #hw_Revision(bTrigger:=NOT #b_Antrieb_Revision_I AND #bFreigabe_I,
	                     wBezeichnung_ID:=INT_TO_WORD(#WMS_BezeichnungsNr_I));
	        
	        // Zeitsynchronisation fehlgeschlagen
	        // "Hinweis_Setzen_FC"(nr := #iErsterHinweis_I + 2,
	        //                     trigger := #Zeitsynchronisation.bLetzterSyncFehlgeschlagen_O AND #bFreigabe_I);
	        #hw_ZeitsyncFehlgeschlagen(bTrigger:=#Zeitsynchronisation.bLetzterSyncFehlgeschlagen_O AND #bFreigabe_I,
	                                   wBezeichnung_ID:=INT_TO_WORD(#WMS_BezeichnungsNr_I));
	        
	    END_REGION
	    
	END_REGION
	
END_FUNCTION_BLOCK

