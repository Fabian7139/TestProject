FUNCTION_BLOCK "WW_DTL_TO_WT2_FB"
TITLE = WW_DTL_TO_WT2_FB
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : indico
VERSION : 1.2
   VAR_INPUT 
      dtlAktuelleZeit_I {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      bAktuelleZeitGueltig_I : Bool;
   END_VAR

   VAR_OUTPUT 
      dtlAktuelleZeitWT2_O {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      bLetzterSyncFehlgeschlagen_O : Bool;
   END_VAR

   VAR_IN_OUT 
      iManuelSync_IO : Int;   // 0 = OK / 1 = Anforderung / 2=Warten / 3= Error
      Platform_Befehl_UDT_IO : "WT2_Pf_Befehl_UDT";
      Platform_Status_UDT_IO : "WT2_Pf_Status_UDT";
   END_VAR

   VAR 
      iLastWeekDay : Int;
      bDaySyncOk : Bool;
      bSyncEvent { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      bSyncAktiv : Bool;
      dtlOldTime {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      TON_SyncTimeOut {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
   END_VAR

   VAR_TEMP 
      bSyncError : Bool;
      dtlTemp {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      dTemp : Date;
      tDiff : Time;
      tSub : Time;
      usiTemp : USInt;
      bTON_IN_PREV : Bool;
   END_VAR


BEGIN
	(*****************************************************************************
	* TIA-SOFTWARE
	* W. Wettstein AG, 3073 Gümligen
	* ========================================
	*
	* INDICO ELECTRONIC AG
	* Mattenstrasse 11
	* 3073 Gümligen
	*
	* Zeitsynchronisation
	*
	* Beschreibung     :     Wettronic Zeit von SPS synchronisieren
	* Erstellt         :     jf
	* Erstellungsdatum :     17.05.2018
	******************************************************************************)
	
	(*
	*  Aenderungs- und Versionshistory
	*
	*  Version      | Datum         | Autor         | Aenderungen
	*  -------------------------------------------------------------
	*
	*  V1.00        17.05.2018        jf            - Neu erstellt
	*  V1.10        14.08.2018        jf            - Überprüfung Handshake = 0 eingefügt / bSyncEvent zwischenspeichern
	*  V1.20        29.09.2023        sf            - Fehlverhalten von TON Timer abfangen falls sie reinitialisiert werden und stehen bleiben
	*                                               
	*)
	
	
	(* Abhängikeiten
	* - ByteToCharDEZ_FC
	* - T_DIFF / T_SUB (Siemens Bausteine)
	*)
	
	
	// Differenzzeit berechnen
	#tDiff := T_DIFF(IN1 := #dtlAktuelleZeit_I, IN2 := #dtlOldTime);
	// Um 03:05 sync auslösen
	#tSub := T_SUB(IN2 := DTL_TO_TOD(#dtlAktuelleZeit_I), IN1 := T#185m);
	
	
	REGION Synchronisierung auslösen
	    IF #bAktuelleZeitGueltig_I AND NOT #bSyncAktiv AND ( // Zeit muss gültig sein
	        (#tDiff > T#5s OR #tDiff < T#-5s) OR // Zeit hat sich verändert auf der SPS
	        (#tSub < T#0s AND NOT #bDaySyncOk) OR// Täglicher Sync um 03:05
	        #iManuelSync_IO = 1) THEN // Manuelles synchronisiseren ausgelöst
	        #bSyncEvent := TRUE;
	        #bLetzterSyncFehlgeschlagen_O := FALSE;
	    END_IF;
	END_REGION
	
	
	IF (#bSyncEvent AND #Platform_Befehl_UDT_IO.iHandshake = 0) OR #bSyncAktiv THEN
	    REGION Synchronisieren
	        // Datum
	        // Fixe Stellen
	        #Platform_Befehl_UDT_IO.Datum[2] := '.';
	        #Platform_Befehl_UDT_IO.Datum[5] := '.';
	        #Platform_Befehl_UDT_IO.Datum[6] := '2';
	        #Platform_Befehl_UDT_IO.Datum[7] := '0';
	        // Jahr 
	        "ByteToCharDEZ_FC"(byte_I := UINT_TO_BYTE(#dtlAktuelleZeit_I.YEAR - 2000),
	                           charH_O => #Platform_Befehl_UDT_IO.Datum[8],
	                           charL_O => #Platform_Befehl_UDT_IO.Datum[9]);
	        
	        // Monat
	        "ByteToCharDEZ_FC"(byte_I := USINT_TO_BYTE(#dtlAktuelleZeit_I.MONTH),
	                           charH_O => #Platform_Befehl_UDT_IO.Datum[3],
	                           charL_O => #Platform_Befehl_UDT_IO.Datum[4]);
	        // Tag
	        "ByteToCharDEZ_FC"(byte_I := USINT_TO_BYTE(#dtlAktuelleZeit_I.DAY),
	                           charH_O => #Platform_Befehl_UDT_IO.Datum[0],
	                           charL_O => #Platform_Befehl_UDT_IO.Datum[1]);
	        // Zeit
	        // Fixe Stellen
	        #Platform_Befehl_UDT_IO.Zeit[2] := ':';
	        #Platform_Befehl_UDT_IO.Zeit[5] := ':';
	        // Std
	        "ByteToCharDEZ_FC"(byte_I := USINT_TO_BYTE(#dtlAktuelleZeit_I.HOUR),
	                           charH_O => #Platform_Befehl_UDT_IO.Zeit[0],
	                           charL_O => #Platform_Befehl_UDT_IO.Zeit[1]);
	        // Minuten
	        "ByteToCharDEZ_FC"(byte_I := USINT_TO_BYTE(#dtlAktuelleZeit_I.MINUTE),
	                           charH_O => #Platform_Befehl_UDT_IO.Zeit[3],
	                           charL_O => #Platform_Befehl_UDT_IO.Zeit[4]);
	        // Sek
	        "ByteToCharDEZ_FC"(byte_I := USINT_TO_BYTE(#dtlAktuelleZeit_I.SECOND),
	                           charH_O => #Platform_Befehl_UDT_IO.Zeit[6],
	                           charL_O => #Platform_Befehl_UDT_IO.Zeit[7]);
	        
	        IF NOT #bSyncAktiv THEN //
	            #Platform_Befehl_UDT_IO.iHandshake := 1; // Wettronic mitteilen das neue Daten vorhanden sind.
	        END_IF;
	        
	        #bSyncEvent := FALSE; // SyncEvent Start
	        #bSyncAktiv := TRUE;
	        #iManuelSync_IO := 2;
	        
	    END_REGION
	ELSE
	    ; // warten
	END_IF;
	
	REGION Überwachung Synchronisation
	
	    
	    // Erfolgreich
	    IF #bSyncAktiv AND #Platform_Befehl_UDT_IO.iHandshake = 0 THEN
	        #bDaySyncOk := TRUE; // Täglicher sync ausgeführt!
	        #iManuelSync_IO := 0; // Manueller Sync zurücksetzten
	        #bSyncAktiv := FALSE;
	    END_IF;
	    
	    // Fehlverhalten von TON Timer abfangen falls sie reinitialisiert werden und stehen bleiben
	    #bTON_IN_PREV := #TON_SyncTimeOut.IN; // Trigger Zustand aus letztem Zyklus speichern
	    #TON_SyncTimeOut(IN := #bSyncAktiv AND #Platform_Befehl_UDT_IO.iHandshake = 1,
	                     PT := T#10s,
	                     Q => #bSyncError);
	    IF #bTON_IN_PREV AND #TON_SyncTimeOut.IN AND NOT #TON_SyncTimeOut.Q AND #TON_SyncTimeOut.ET = T#0ms THEN
	        RESET_TIMER(#TON_SyncTimeOut);
	    END_IF;
	    
	    IF #bSyncError THEN
	        #bDaySyncOk := TRUE; // Täglicher sync versucht!
	        #bSyncAktiv := FALSE; // Sync abgebrochen
	        #Platform_Befehl_UDT_IO.iHandshake := 0; // Zeit nicht mehr gültig
	        #bLetzterSyncFehlgeschlagen_O := TRUE;
	        #iManuelSync_IO := 3; // Manueller Sync zurücksetzten
	    END_IF;
	
	    
	END_REGION
	
	
	
	
	REGION Täglicher Sync wieder aktivieren
	    // Täglicher Sync wieder aktivieren
	    IF #bDaySyncOk AND #iLastWeekDay <> #dtlAktuelleZeit_I.WEEKDAY THEN
	        #bDaySyncOk := FALSE;
	    END_IF;
	END_REGION
	
	
	// Zeiten zwischenspeichern
	#dtlOldTime := #dtlAktuelleZeit_I;
	#iLastWeekDay := #dtlAktuelleZeit_I.WEEKDAY;
	
	REGION WT2 Zeit lesen
	    // Datum
	    #dtlTemp.DAY := BYTE_TO_USINT("CharToByteDEZ_FC"(charH_I := #Platform_Status_UDT_IO.Datum[0],
	                                                                                   charL_I := #Platform_Status_UDT_IO.Datum[1]));
	    #dtlTemp.MONTH := BYTE_TO_USINT("CharToByteDEZ_FC"(charH_I := #Platform_Status_UDT_IO.Datum[3],
	                                                                                       charL_I := #Platform_Status_UDT_IO.Datum[4]));
	    #dtlTemp.YEAR := BYTE_TO_UINT("CharToByteDEZ_FC"(charH_I := #Platform_Status_UDT_IO.Datum[8],
	                                                                                   charL_I := #Platform_Status_UDT_IO.Datum[9])) + 2000;
	    // Zeit
	    #dtlTemp.HOUR := BYTE_TO_USINT("CharToByteDEZ_FC"(charH_I := #Platform_Status_UDT_IO.Zeit[0],
	                                                                                     charL_I := #Platform_Status_UDT_IO.Zeit[1]));
	    
	    #dtlTemp.MINUTE := BYTE_TO_USINT("CharToByteDEZ_FC"(charH_I := #Platform_Status_UDT_IO.Zeit[3],
	                                                                                         charL_I := #Platform_Status_UDT_IO.Zeit[4]));
	
	    #dtlTemp.SECOND := BYTE_TO_USINT("CharToByteDEZ_FC"(charH_I := #Platform_Status_UDT_IO.Zeit[6],
	                                                                                         charL_I := #Platform_Status_UDT_IO.Zeit[7]));
	    
	    
	    
	    #dTemp := DTL_TO_DATE(#dtlTemp);
	    #dtlTemp.WEEKDAY := DINT_TO_USINT((DATE_TO_DINT(#dTemp) + 7309) MOD 7) + 1;
	    
	    
	    
	    #dtlAktuelleZeitWT2_O := T_ADD(IN1 := #dtlTemp, IN2 := T#1s); // Korrektur für das lesen der Zeit vom WT2
	END_REGION
	
END_FUNCTION_BLOCK

