FUNCTION "CharToByteDEZ_FC" : Byte
{ S7_Optimized_Access := 'FALSE' }
AUTHOR : indico
VERSION : 0.1
   VAR_INPUT 
      charH_I : Char;
      charL_I : Char;
   END_VAR

   VAR_TEMP 
      iLow : Byte;
      iHigh : Byte;
   END_VAR


BEGIN
	(*****************************************************************************
	* TIA-SOFTWARE
	* W. Wettstein AG, 3073 Gümligen
	* ========================================
	*
	* INDICO ELECTRONIC AG
	* Mattenstrasse 11
	* 3073 Gümligen
	*
	* Zeitsynchronisation
	*
	* Beschreibung     :     Char to Byte
	* Erstellt         :     jf
	* Erstellungsdatum :     07.12.2018
	******************************************************************************)
	
	(*
	*  Aenderungs- und Versionshistory
	*
	*  Version      | Datum         | Autor         | Aenderungen
	*  -------------------------------------------------------------
	*
	*  V1.00        07.12.2018        jf            -Neu erstellt
	*                                               
	*)
	
	
	(* Abhängikeiten
	* - CHAR_TO_BYTE
	*)
	
	#iHigh := CHAR_TO_BYTE(#charH_I) - 48;
	#iLow := CHAR_TO_BYTE(#charL_I) - 48;
	
	#CharToByteDEZ_FC := #iHigh * 10 + #iLow;
	
	
END_FUNCTION

