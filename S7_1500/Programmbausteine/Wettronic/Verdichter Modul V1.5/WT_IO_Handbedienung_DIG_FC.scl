FUNCTION "WT_IO_Handbedienung_DIG_FC" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      bEingang_I : Bool;
   END_VAR

   VAR_OUTPUT 
      iZustand_O : Int;   // 0=AUS / 1=EIN / 10=Hand AUS / 11=Hand EIN
      bAusgang_O : Bool;
   END_VAR

   VAR_IN_OUT 
      bHandAktiv_IO : Bool;   // Globale Hand Variable
      iBetriebsart_IO : Int;   // 0=Auto / 1=Hand EIN / 2=Hand AUS
   END_VAR


BEGIN
	(*****************************************************************************
	* TIA-SOFTWARE
	* W. Wettstein AG, 3073 Gümligen
	* ========================================
	*
	* INDICO ELECTRONIC AG
	* Mattenstrasse 11
	* 3073 Gümligen
	*
	* WT IO Handbedienung DIGITAL
	*
	* Beschreibung     :     WT IO Handbedienung
	* Erstellt         :     jf
	* Erstellungsdatum :     04.12.2018
	******************************************************************************)
	
	(*
	*  Aenderungs- und Versionshistory
	*
	*  Version      | Datum         | Autor         | Aenderungen
	*  -------------------------------------------------------------
	*
	*  V1.00        04.12.2018        jf            -Neu erstellt
	*                                               
	*)
	
	
	CASE #iBetriebsart_IO OF
	    0:  // AUTO
	        #iZustand_O := BOOL_TO_INT(#bEingang_I);
	        #bAusgang_O := #bEingang_I;
	        
	    1:  // Hand EIN
	        #iZustand_O := 11;
	        #bHandAktiv_IO := TRUE;
	        #bAusgang_O := TRUE;
	
	    2:  // Hand AUS
	        #iZustand_O := 10;
	        #bHandAktiv_IO := TRUE;
	        #bAusgang_O := FALSE;
	        
	    ELSE  // Statement section ELSE
	        #iBetriebsart_IO := 0;
	END_CASE;
	
	
	
	         
	
	
	
	
	
	
	
	
	
END_FUNCTION

