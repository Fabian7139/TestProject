FUNCTION_BLOCK "WMS_MessageInterface_FB"
TITLE = WMS_MessageInterface_FB
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : indico
FAMILY : WMS
VERSION : 1.1
   VAR 
      hw_UeberbrueckungAktiv { ExternalVisible := 'False'; S7_SetPoint := 'False'} : "WMS_MeldungsWrapperOhneQuit_FB";
      hw_HsAusgeschaltet { ExternalVisible := 'False'; S7_SetPoint := 'False'} : "WMS_MeldungsWrapperOhneQuit_FB";
      al_KommunikationVisu0 : "WMS_MeldungsWrapperMitQuit_FB";
   END_VAR

   VAR_TEMP 
      bSammelquitt : Bool;
      bMessageSchalterAus : Bool;
      bKommFehler : Bool;
   END_VAR


BEGIN
	(*****************************************************************************
	* TIA-SOFTWARE
	* W. Wettstein AG, 3073 Gümligen
	* ========================================
	*
	* INDICO ELECTRONIC AG
	* Mattenstrasse 11
	* 3073 Gümligen
	*
	* Beschreibung     :     MessageInterface
	* Erstellt         :     sf
	* Erstellungsdatum :     07.07.2022
	*
	******************************************************************************)
	
	(*
	*  Aenderungs- und Versionshistory
	*
	*  Version      | Datum         | Autor         | Aenderungen
	*  -------------------------------------------------------------
	*  V1.0         07.07.2022      sf              - Erste Version
	*  V1.1         09.12.2022      sf              - Neu wird an Stelle WinCC, das Lebensbit vom WMS überwacht
	*
	*)
	
	// Interface zwischen User-Programm und WMS MeldungsHandler
	
	// Aufbereitung der Sammel-Quittierungs-Signale
	#bSammelquitt := "resetAlarme_M" OR "WMS_WinCC_Div_DB".commVisu[0].bQuitAnSPS OR "WMS_WinCC_Div_DB".commVisu[1].bQuitAnSPS OR "WMS_WinCC_Div_DB".commWMS[0].bQuitAnSPS;
	"Zyklus_DB".bAlarmReset := #bSammelquitt;
	
	REGION Reset-Taste von SPS an Panels weitergeben
	    IF "resetAlarme_M" AND NOT ("flankeResetAlarm_M") THEN
	        "WMS_WinCC_Div_DB".commVisu[0].bQuitVonSPS := TRUE;
	        "WMS_WinCC_Div_DB".commVisu[1].bQuitVonSPS := TRUE;
	    END_IF;
	    "flankeResetAlarm_M" := "resetAlarme_M"; //Flanke speichern
	END_REGION
	
	REGION Sammel-Quittierbit von Panel 0
	    IF "WMS_WinCC_Div_DB".commVisu[0].bQuitAnSPS THEN
	        "WMS_WinCC_Div_DB".commVisu[1].bQuitVonSPS := TRUE; // an Panel 1 weitergeben
	        
	        "WMS_WinCC_Div_DB".commWMS[0].bQuitVonSPS := TRUE;  // an WMS weitergeben
	        
	        "WMS_WinCC_Div_DB".commVisu[0].bQuitAnSPS := FALSE; // und danach zurücksetzen
	    END_IF;
	END_REGION
	
	REGION Sammel-Quittierbit von Panel 1
	    IF "WMS_WinCC_Div_DB".commVisu[1].bQuitAnSPS THEN
	        "WMS_WinCC_Div_DB".commVisu[0].bQuitVonSPS := TRUE;  // an Panel 0 weitergeben
	        
	        "WMS_WinCC_Div_DB".commWMS[0].bQuitVonSPS := TRUE;  // an WMS weitergeben
	        
	        "WMS_WinCC_Div_DB".commVisu[1].bQuitAnSPS := FALSE; // und danach zurücksetzen
	    END_IF;
	END_REGION
	
	REGION Sammel-Quittierbit von WMS
	    // Vorbereitet, Sammelquit von WMS wird aktuell nicht verwendet
	    IF "WMS_WinCC_Div_DB".commWMS[0].bQuitAnSPS THEN
	        "WMS_WinCC_Div_DB".commVisu[0].bQuitVonSPS := TRUE;  // an Panel 0 weitergeben
	        "WMS_WinCC_Div_DB".commVisu[1].bQuitVonSPS := TRUE;  // an Panel 0 weitergeben
	        
	        "WMS_WinCC_Div_DB".commWMS[0].bQuitAnSPS := FALSE; // und danach zurücksetzen
	    END_IF;
	END_REGION
	
	
	
	REGION MeldungsHandler
	    "WMS_MeldungsHandler_IDB"(bSammelquittierung := #bSammelquitt,
	                              bSekTakt := "Clock_1Hz",
	                              bSammelhinweis => "sammelHinweis_M",
	                              bSammelalarm => "sammelAlarm_M",
	                              bAlUeberbrueckAktiv => "ueberbrueckung_M",
	                              bAnyHsAus => #bMessageSchalterAus,
	                              bKanal_1 => "channel_1_M",
	                              bKanal_2 => "channel_2_M",
	                              bKanal_3 => "channel_3_M",
	                              bKanal_4 => "channel_4_M",
	                              bKanal_5 => "channel_5_M",
	                              bKanal_6 => "channel_6_M",
	                              bKanal_7 => "channel_7_M",
	                              bKanal_8 => "channel_8_M",
	                              bKanal_9 => "channel_9_M",
	                              bKanal_10 => "channel_10_M",
	                              bKanal_11 => "channel_11_M",
	                              bKanal_12 => "channel_12_M",
	                              bKanal_13 => "channel_13_M",
	                              bKanal_14 => "channel_14_M",
	                              bKanal_15 => "channel_15_M",
	                              bKanal_16 => "channel_16_M",
	                              bPrio_0_AktivNachQuit => "bPrio_0_Aktiv",
	                              bPrio_1_AktivNachQuit => "bPrio_1_Aktiv",
	                              bPrio_2_AktivNachQuit => "bPrio_2_Aktiv",
	                              bPrio_3_AktivNachQuit => "bPrio_3_Aktiv",
	                              bPrio_0_PasivNachQuit => "bPrio_0_Passiv",
	                              bPrio_1_PasivNachQuit => "bPrio_1_Passiv",
	                              bPrio_2_PasivNachQuit => "bPrio_2_Passiv",
	                              bPrio_3_PasivNachQuit => "bPrio_3_Passiv");
	END_REGION
	
	// Anfahren nach Sicherheitsalarm PopUp in HMI
	"WMS_WinCC_Div_DB".bAnfahrenNachSicherheitsAlarmVerlangt := FALSE; // Im Normalfall von Safety SPS
	
	// Hinweis Überbrückungsschalter aktiv
	#hw_UeberbrueckungAktiv(bTrigger := "ueberbrueckung_M",
	                        wEreignis_ID := 1,
	                        wBezeichnung_ID := 0);
	
	// Hinweis Hauptschalter ausgeschaltet
	#hw_HsAusgeschaltet(bTrigger := #bMessageSchalterAus,
	                    wEreignis_ID := 2,
	                    wBezeichnung_ID := 0);
	
	REGION Lebensbit An/Von Visu und WMS
	    // Lebensbit von WMS überwachen
	    #al_KommunikationVisu0(bTrigger := NOT "WMS_WinCC_Div_DB".commWMS[0].bAliveAnSPS,
	                           wEreignis_ID := 3,
	                           wBezeichnung_ID := 5,
	                           bExist => #bKommFehler);
	    
	    // Lebensbit von Visu rücksetzen
	    "WMS_WinCC_Div_DB".commVisu[0].bAliveAnSPS := FALSE;
	    "WMS_WinCC_Div_DB".commVisu[1].bAliveAnSPS := FALSE;
	    
	    // Lebensbit an Visu setzen
	    "WMS_WinCC_Div_DB".commVisu[0].bAliveVonSPS := TRUE;
	    "WMS_WinCC_Div_DB".commVisu[1].bAliveVonSPS := TRUE;
	        
	    // Lebensbit von WMS rücksetzen
	    "WMS_WinCC_Div_DB".commWMS[0].bAliveAnSPS := FALSE;
	    
	    // Lebensbit an WMS setzen
	    "WMS_WinCC_Div_DB".commWMS[0].bAliveVonSPS := TRUE;
	END_REGION
	
END_FUNCTION_BLOCK

